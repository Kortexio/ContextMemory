{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "query_objects",
  "description": "Query CRM objects by type and filter. Requires objectType and a non-empty where clause.",
  "type": "object",
  "additionalProperties": false,
  "required": ["objectType", "where"],
  "properties": {
    "objectType": {
      "type": "string",
      "enum": ["Account", "Invoice", "Subscription"],
      "description": "CRM object type to query"
    },
    "where": {
      "type": "object",
      "description": "Filter map; at least one field required",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      },
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    }
  }
}
