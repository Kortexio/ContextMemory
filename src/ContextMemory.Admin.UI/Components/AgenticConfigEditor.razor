@using ContextMemory.Core.Agentic
@using ContextMemory.Admin.UI.Models
@using ContextMemory.Admin.UI.Services

<div class="card card-outline card-warning mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">Agentic Gateway</h5>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            When enabled (or when Global Wiki is on), the gateway may run a multi-step tool loop on the same
            <code>/v1/chat/completions</code> (or deprecated <code>/api/chat</code>) request. Clients still receive a normal final message.
        </p>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" id="agenticEnabled" @bind-Value="Model.Enabled" />
            <label class="form-check-label" for="agenticEnabled">Enable agentic loop for this tenant</label>
            <FieldHelp>Turns on ACA/MCP tools for this app. Global Wiki can still work independently.</FieldHelp>
        </div>

        <div class="form-row">
            <div class="col-md-4 form-group">
                <label>Prompt profile</label>
                <InputSelect class="form-control" @bind-Value="Model.PromptProfile">
                    <option value="auto">auto</option>
                    <option value="ollama">ollama</option>
                    <option value="openai">openai</option>
                    <option value="claude">claude</option>
                    <option value="qwen">qwen</option>
                    <option value="composer">composer</option>
                </InputSelect>
                <FieldHelp>Harness profile (prompt + protocol capabilities). <code>auto</code> picks from model/backend.</FieldHelp>
            </div>
            <div class="col-md-4 form-group">
                <label>Validation mode</label>
                <InputSelect class="form-control" @bind-Value="Model.Guardrails.ValidationMode">
                    <option value="hybrid">hybrid</option>
                    <option value="deterministic">deterministic</option>
                    <option value="llm-judge">llm-judge</option>
                </InputSelect>
                <FieldHelp>How answers are checked before returning to the client.</FieldHelp>
            </div>
            <div class="col-md-4 form-group">
                <label>Network egress</label>
                <InputSelect class="form-control" @bind-Value="Model.Guardrails.NetworkEgress">
                    <option value="restricted">restricted</option>
                    <option value="allowed">allowed</option>
                </InputSelect>
                <FieldHelp>Whether tools may reach the public internet (<code>restricted</code> = allow-list only).</FieldHelp>
            </div>
        </div>

        <div class="form-row">
            <div class="col-md-3 form-group">
                <label>Max iterations</label>
                <InputNumber class="form-control" @bind-Value="Model.Guardrails.MaxIterations" />
                <FieldHelp><code>0</code> = prompt-profile default (qwen 12, openai 12, composer 24, …).</FieldHelp>
            </div>
            <div class="col-md-3 form-group">
                <label>Loop timeout (s)</label>
                <InputNumber class="form-control" @bind-Value="Model.Guardrails.LoopTimeoutSeconds" />
                <FieldHelp>Whole-loop deadline in seconds. <code>0</code> = API default.</FieldHelp>
            </div>
            <div class="col-md-3 form-group">
                <label>Min answer length</label>
                <InputNumber class="form-control" @bind-Value="Model.Guardrails.MinAnswerLength" />
                <FieldHelp>Reject empty/short finals under this character count (0 = off).</FieldHelp>
            </div>
            <div class="col-md-3 form-group">
                <label>Require confirmation for</label>
                <InputText class="form-control" @bind-Value="ConfirmationKeywordsText"
                           placeholder="delete, deploy-prod" />
                <FieldHelp>Comma-separated keywords that pause for human confirmation before tool run.</FieldHelp>
            </div>
        </div>

        <div class="form-row">
            <div class="col-md-6 form-group">
                <label>Allowed egress hosts</label>
                <InputText class="form-control" @bind-Value="AllowedHostsText"
                           placeholder="internal.example.com, api.corp.local" />
                <FieldHelp>Comma-separated hosts allowed when egress is restricted.</FieldHelp>
            </div>
            <div class="col-md-6 form-group">
                <label>Expected answer patterns (regex)</label>
                <InputText class="form-control" @bind-Value="ExpectedPatternsText"
                           placeholder="^## Summary" />
                <FieldHelp>Optional regexes the final answer should match (comma-separated).</FieldHelp>
            </div>
        </div>

        <div class="form-check mb-2">
            <InputCheckbox class="form-check-input" @bind-Value="Model.Guardrails.RequireZeroExitCode" />
            <label class="form-check-label">Require exit code 0 for all tools</label>
            <FieldHelp>Fail the loop if a shell/python tool returns a non-zero exit code.</FieldHelp>
        </div>
        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="Model.Guardrails.HumanReviewOnMaxIterations" />
            <label class="form-check-label">Human review when max iterations is reached</label>
            <FieldHelp>Escalate instead of returning a partial answer when the iteration cap is hit.</FieldHelp>
        </div>

        <h6 class="mt-4">Execution tools</h6>
        <FieldHelp>
            Code runners for shell/python/node.
            Use <code>self-hosted-sandbox</code> with <code>http://sandbox-runtime:8080</code> in Docker,
            or <code>aca-session</code> with an Azure Dynamic Sessions pool URL.
            (Different from MCP runtime.)
        </FieldHelp>
        @for (var i = 0; i < Model.Tools.Execution.Count; i++)
        {
            var index = i;
            <div class="border rounded p-2 mb-2">
                <div class="form-row">
                    <div class="col-md-3 form-group mb-2">
                        <label>Type</label>
                        <InputSelect class="form-control form-control-sm" @bind-Value="Model.Tools.Execution[index].Type">
                            <option value="self-hosted-sandbox">self-hosted-sandbox</option>
                            <option value="aca-session">aca-session</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3 form-group mb-2">
                        <label>Runtime</label>
                        <InputSelect class="form-control form-control-sm" @bind-Value="Model.Tools.Execution[index].Runtime">
                            <option value="shell">shell</option>
                            <option value="python">python</option>
                            <option value="node">node</option>
                            @if (Model.Tools.Execution[index].Type == "aca-session")
                            {
                                <option value="custom">custom</option>
                            }
                        </InputSelect>
                        <FieldHelp>Language runtime inside the sandbox/pool.</FieldHelp>
                    </div>
                    <div class="col-md-5 form-group mb-2">
                        <label>@(Model.Tools.Execution[index].Type == "self-hosted-sandbox" ? "Sandbox endpoint" : "Pool endpoint")</label>
                        @if (Model.Tools.Execution[index].Type == "self-hosted-sandbox")
                        {
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="Model.Tools.Execution[index].SandboxEndpoint"
                                       placeholder="http://sandbox-runtime:8080" />
                            <FieldHelp>Base URL of the sandbox service (<code>POST /execute</code>).</FieldHelp>
                        }
                        else
                        {
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="Model.Tools.Execution[index].PoolEndpoint"
                                       placeholder="https://….azurecontainerapps.io" />
                            <FieldHelp>ACA Dynamic Sessions pool base URL.</FieldHelp>
                        }
                    </div>
                    <div class="col-md-1 d-flex align-items-end mb-2">
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                @onclick="() => RemoveExecution(index)">×</button>
                    </div>
                </div>
                @if (Model.Tools.Execution[index].Type == "aca-session" && Model.Tools.Execution[index].Runtime == "custom")
                {
                    <div class="form-group mb-2">
                        <label>Container image (custom)</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Execution[index].ContainerImage" />
                    </div>
                }
                <div class="form-check">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.Tools.Execution[index].AllowEgress" />
                    <label class="form-check-label">allowEgress</label>
                </div>
            </div>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary mb-3" @onclick="AddExecution">+ execution runtime</button>

        <h6>Integration tools (MCP)</h6>
        <FieldHelp>
            Model Context Protocol servers this tenant may call. Supports
            <code>http</code> (remote URL) and <code>stdio</code> (local process, Cursor-style).
        </FieldHelp>
        <details class="mb-3">
            <summary class="small text-muted" style="cursor:pointer">Example MCP JSON (stdio + http)</summary>
            <pre class="small bg-light border rounded p-2 mt-2 mb-0" style="white-space:pre-wrap">@ExampleMcpJson</pre>
        </details>
        <div class="form-group mb-3" style="max-width: 12rem;">
            <label>Max MCP tools / turn</label>
            <InputNumber class="form-control form-control-sm" @bind-Value="Model.Tools.MaxMcpToolsPerTurn" />
        </div>
        @for (var i = 0; i < Model.Tools.Integrations.Count; i++)
        {
            var index = i;
            <div class="border rounded p-2 mb-2">
                <div class="form-row">
                    <div class="col-md-3 form-group mb-2">
                        <label>Name</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].Name" />
                    </div>
                    <div class="col-md-2 form-group mb-2">
                        <label>Transport</label>
                        <InputSelect class="form-control form-control-sm"
                                    @bind-Value="Model.Tools.Integrations[index].Transport">
                            <option value="http">http</option>
                            <option value="stdio">stdio</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4 form-group mb-2">
                        <label>@(Model.Tools.Integrations[index].Transport == "stdio" ? "Command" : "URL")</label>
                        @if (Model.Tools.Integrations[index].Transport == "stdio")
                        {
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="Model.Tools.Integrations[index].Command"
                                       placeholder="node / npx / python" />
                        }
                        else
                        {
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="Model.Tools.Integrations[index].Url"
                                       placeholder="https://mcp.example.com" />
                        }
                    </div>
                    <div class="col-md-2 form-group mb-2">
                        <label>Auth mode</label>
                        <InputSelect class="form-control form-control-sm"
                                    @bind-Value="Model.Tools.Integrations[index].AuthMode">
                            <option value="">none</option>
                            <option value="bearer">bearer</option>
                            <option value="api-key">api-key</option>
                            <option value="oauth-per-tenant">oauth-per-tenant</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-1 d-flex align-items-end mb-2">
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                @onclick="() => RemoveIntegration(index)">×</button>
                    </div>
                </div>
                @if (Model.Tools.Integrations[index].Transport == "stdio")
                {
                    <div class="form-row">
                        <div class="col-md-8 form-group mb-2">
                            <label>Args (comma-separated)</label>
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="Model.Tools.Integrations[index].ArgsText"
                                       placeholder="-y, package-name" />
                        </div>
                        <div class="col-md-4 form-group mb-2">
                            <label>Working directory</label>
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="Model.Tools.Integrations[index].WorkingDirectory" />
                        </div>
                    </div>
                    <div class="form-group mb-2">
                        <label>Env (KEY=value per line; non-secret)</label>
                        <InputTextArea class="form-control form-control-sm" rows="3"
                                       @bind-Value="Model.Tools.Integrations[index].EnvText"
                                       placeholder="API_BASE_URL=https://example.com" />
                    </div>
                }
                <div class="form-row">
                    <div class="col-md-4 form-group mb-2">
                        <label>Credential ref</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].CredentialRef"
                                   placeholder="jira-prod" />
                        <FieldHelp>Secrets live outside ConfigJson.</FieldHelp>
                    </div>
                    <div class="col-md-4 form-group mb-2">
                        <label>Timeout (s)</label>
                        <InputNumber class="form-control form-control-sm"
                                     @bind-Value="Model.Tools.Integrations[index].TimeoutSeconds" />
                    </div>
                    <div class="col-md-4 form-group mb-2">
                        <label>Description</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].Description" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6 form-group mb-2">
                        <label>Tool allowlist (comma-separated)</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].ToolAllowlistText" />
                    </div>
                    <div class="col-md-6 form-group mb-2">
                        <label>Tool denylist (comma-separated)</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].ToolDenylistText" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6 form-group mb-0">
                        <label>Auth token (legacy inline; prefer credentialRef)</label>
                        <InputText class="form-control form-control-sm" type="password"
                                   @bind-Value="Model.Tools.Integrations[index].AuthToken" />
                    </div>
                    <div class="col-md-6 form-group mb-0">
                        <label>OAuth token URL</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].OAuth!.TokenUrl" />
                    </div>
                </div>
                <div class="form-row mt-2">
                    <div class="col-md-4 form-group mb-0">
                        <label>OAuth client ID</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].OAuth!.ClientId" />
                    </div>
                    <div class="col-md-4 form-group mb-0">
                        <label>OAuth client secret</label>
                        <InputText class="form-control form-control-sm" type="password"
                                   @bind-Value="Model.Tools.Integrations[index].OAuth!.ClientSecret" />
                    </div>
                    <div class="col-md-4 form-group mb-0">
                        <label>OAuth scope</label>
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="Model.Tools.Integrations[index].OAuth!.Scope" />
                    </div>
                </div>
                <div class="form-check mt-2">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.Tools.Integrations[index].Enabled" />
                    <label class="form-check-label">enabled</label>
                </div>
                <div class="form-check mt-2">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.Tools.Integrations[index].AllowEgress" />
                    <label class="form-check-label">allowEgress</label>
                </div>
            </div>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddIntegration">+ MCP server</button>
    </div>
</div>

@code {
    private static readonly string ExampleMcpJson =
        "{\n" +
        "  \"type\": \"mcp\",\n" +
        "  \"name\": \"example-stdio\",\n" +
        "  \"transport\": \"stdio\",\n" +
        "  \"command\": \"npx\",\n" +
        "  \"args\": [\"-y\", \"@modelcontextprotocol/server-everything\"],\n" +
        "  \"env\": { \"API_BASE_URL\": \"https://example.com\" },\n" +
        "  \"credentialRef\": \"example-stdio\",\n" +
        "  \"enabled\": true,\n" +
        "  \"timeoutSeconds\": 300\n" +
        "}";

    [Parameter] public AgenticConfigForm Model { get; set; } = new();

    private string ConfirmationKeywordsText
    {
        get => string.Join(", ", Model.Guardrails.RequireConfirmationFor);
        set => Model.Guardrails.RequireConfirmationFor = SplitCsv(value);
    }

    private string AllowedHostsText
    {
        get => string.Join(", ", Model.Guardrails.AllowedEgressHosts);
        set => Model.Guardrails.AllowedEgressHosts = SplitCsv(value);
    }

    private string ExpectedPatternsText
    {
        get => string.Join(", ", Model.Guardrails.ExpectedAnswerPatterns);
        set => Model.Guardrails.ExpectedAnswerPatterns = SplitCsv(value);
    }

    private void AddExecution() =>
        Model.Tools.Execution.Add(new ExecutionToolForm());

    private void RemoveExecution(int index) =>
        Model.Tools.Execution.RemoveAt(index);

    private void AddIntegration() =>
        Model.Tools.Integrations.Add(new IntegrationToolForm
        {
            Transport = "stdio",
            Enabled = true,
            OAuth = new IntegrationOAuthForm()
        });

    private void RemoveIntegration(int index) =>
        Model.Tools.Integrations.RemoveAt(index);

    private static List<string> SplitCsv(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    public sealed class AgenticConfigForm
    {
        public bool Enabled { get; set; }
        public string PromptProfile { get; set; } = "auto";
        public AgenticToolsForm Tools { get; set; } = new();
        public AgenticGuardrailsForm Guardrails { get; set; } = new();
        public List<string> EnabledSkillIds { get; set; } = [];
        public List<string> EnabledGuardrailIds { get; set; } = [];
        public bool PolicyPacksExplicit { get; set; }

        public AgenticConfig ToConfig() => new()
        {
            Enabled = Enabled,
            PromptProfile = PromptProfile,
            PolicyPacks = PolicyPacksExplicit
                ? new PolicyPacksConfig
                {
                    EnabledSkillIds = EnabledSkillIds.ToList(),
                    EnabledGuardrailIds = EnabledGuardrailIds.ToList()
                }
                : new PolicyPacksConfig
                {
                    EnabledSkillIds = null,
                    EnabledGuardrailIds = null
                },
            Tools = new AgenticToolsConfig
            {
                MaxMcpToolsPerTurn = Tools.MaxMcpToolsPerTurn > 0 ? Tools.MaxMcpToolsPerTurn : 12,
                Execution = Tools.Execution.Select(e => new ExecutionToolConfig
                {
                    Type = string.IsNullOrWhiteSpace(e.Type) ? "self-hosted-sandbox" : e.Type,
                    Runtime = e.Runtime,
                    PoolEndpoint = e.PoolEndpoint,
                    SandboxEndpoint = e.SandboxEndpoint,
                    ContainerImage = e.ContainerImage,
                    AllowEgress = e.AllowEgress
                }).ToList(),
                Integrations = Tools.Integrations.Select(i => new IntegrationToolConfig
                {
                    Type = "mcp",
                    Name = i.Name,
                    Transport = string.IsNullOrWhiteSpace(i.Transport) ? "http" : i.Transport,
                    Url = i.Url,
                    Command = i.Command,
                    Args = SplitCsv(i.ArgsText),
                    Env = ParseEnv(i.EnvText),
                    WorkingDirectory = i.WorkingDirectory,
                    Enabled = i.Enabled,
                    Description = i.Description,
                    CredentialRef = i.CredentialRef,
                    TimeoutSeconds = i.TimeoutSeconds,
                    ToolAllowlist = SplitCsv(i.ToolAllowlistText),
                    ToolDenylist = SplitCsv(i.ToolDenylistText),
                    AuthMode = i.AuthMode,
                    AuthToken = i.AuthToken,
                    AllowEgress = i.AllowEgress,
                    OAuth = i.OAuth is { TokenUrl.Length: > 0 } oauth
                        ? new McpOAuthConfig
                        {
                            TokenUrl = oauth.TokenUrl,
                            ClientId = oauth.ClientId,
                            ClientSecret = oauth.ClientSecret,
                            Scope = oauth.Scope
                        }
                        : null
                }).ToList()
            },
            Guardrails = new AgenticGuardrailsConfig
            {
                MaxIterations = Guardrails.MaxIterations > 0 ? Guardrails.MaxIterations : 0,
                LoopTimeoutSeconds = Guardrails.LoopTimeoutSeconds,
                ValidationMode = Guardrails.ValidationMode,
                NetworkEgress = Guardrails.NetworkEgress,
                MinAnswerLength = Guardrails.MinAnswerLength,
                RequireConfirmationFor = Guardrails.RequireConfirmationFor,
                AllowedEgressHosts = Guardrails.AllowedEgressHosts,
                ExpectedAnswerPatterns = Guardrails.ExpectedAnswerPatterns,
                RequireZeroExitCode = Guardrails.RequireZeroExitCode,
                HumanReviewOnMaxIterations = Guardrails.HumanReviewOnMaxIterations
            }
        };

        public static AgenticConfigForm FromConfig(AgenticConfig? config)
        {
            config ??= AgenticConfig.Disabled;
            var packs = config.PolicyPacks ?? new PolicyPacksConfig();
            return new AgenticConfigForm
            {
                Enabled = config.Enabled,
                PromptProfile = config.PromptProfile,
                PolicyPacksExplicit = packs.EnabledSkillIds is not null || packs.EnabledGuardrailIds is not null,
                EnabledSkillIds = packs.EnabledSkillIds?.ToList() ?? [],
                EnabledGuardrailIds = packs.EnabledGuardrailIds?.ToList() ?? [],
                Tools = new AgenticToolsForm
                {
                    MaxMcpToolsPerTurn = config.Tools.MaxMcpToolsPerTurn > 0 ? config.Tools.MaxMcpToolsPerTurn : 12,
                    Execution = config.Tools.Execution.Select(e => new ExecutionToolForm
                    {
                        Type = string.IsNullOrWhiteSpace(e.Type) ? "aca-session" : e.Type,
                        Runtime = e.Runtime,
                        PoolEndpoint = e.PoolEndpoint,
                        SandboxEndpoint = e.SandboxEndpoint,
                        ContainerImage = e.ContainerImage,
                        AllowEgress = e.AllowEgress
                    }).ToList(),
                    Integrations = config.Tools.Integrations.Select(i => new IntegrationToolForm
                    {
                        Name = i.Name,
                        Transport = i.IsStdioTransport ? "stdio" : "http",
                        Url = i.Url,
                        Command = i.Command,
                        ArgsText = string.Join(", ", i.Args),
                        EnvText = FormatEnv(i.Env),
                        WorkingDirectory = i.WorkingDirectory,
                        Enabled = i.Enabled,
                        Description = i.Description,
                        CredentialRef = i.CredentialRef,
                        TimeoutSeconds = i.TimeoutSeconds,
                        ToolAllowlistText = string.Join(", ", i.ToolAllowlist),
                        ToolDenylistText = string.Join(", ", i.ToolDenylist),
                        AuthMode = i.AuthMode,
                        AuthToken = i.AuthToken,
                        AllowEgress = i.AllowEgress,
                        OAuth = new IntegrationOAuthForm
                        {
                            TokenUrl = i.OAuth?.TokenUrl ?? string.Empty,
                            ClientId = i.OAuth?.ClientId ?? string.Empty,
                            ClientSecret = i.OAuth?.ClientSecret ?? string.Empty,
                            Scope = i.OAuth?.Scope
                        }
                    }).ToList()
                },
                Guardrails = new AgenticGuardrailsForm
                {
                    MaxIterations = config.Guardrails.MaxIterations,
                    LoopTimeoutSeconds = config.Guardrails.LoopTimeoutSeconds,
                    ValidationMode = config.Guardrails.ValidationMode,
                    NetworkEgress = config.Guardrails.NetworkEgress,
                    MinAnswerLength = config.Guardrails.MinAnswerLength,
                    RequireConfirmationFor = config.Guardrails.RequireConfirmationFor.ToList(),
                    AllowedEgressHosts = config.Guardrails.AllowedEgressHosts.ToList(),
                    ExpectedAnswerPatterns = config.Guardrails.ExpectedAnswerPatterns.ToList(),
                    RequireZeroExitCode = config.Guardrails.RequireZeroExitCode,
                    HumanReviewOnMaxIterations = config.Guardrails.HumanReviewOnMaxIterations
                }
            };
        }

        private static Dictionary<string, string>? ParseEnv(string? text)
        {
            if (string.IsNullOrWhiteSpace(text))
                return null;

            var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var line in text.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var idx = line.IndexOf('=');
                if (idx <= 0)
                    continue;
                map[line[..idx].Trim()] = line[(idx + 1)..].Trim();
            }

            return map.Count == 0 ? null : map;
        }

        private static string FormatEnv(Dictionary<string, string>? env) =>
            env is null || env.Count == 0
                ? string.Empty
                : string.Join('\n', env.Select(kv => $"{kv.Key}={kv.Value}"));
    }

    public sealed class AgenticToolsForm
    {
        public int MaxMcpToolsPerTurn { get; set; } = 12;
        public List<ExecutionToolForm> Execution { get; set; } = [];
        public List<IntegrationToolForm> Integrations { get; set; } = [];
    }

    public sealed class ExecutionToolForm
    {
        public string Type { get; set; } = "self-hosted-sandbox";
        public string Runtime { get; set; } = "python";
        public string? PoolEndpoint { get; set; }
        public string? SandboxEndpoint { get; set; } = "http://sandbox-runtime:8080";
        public string? ContainerImage { get; set; }
        public bool AllowEgress { get; set; } = true;
    }

    public sealed class IntegrationToolForm
    {
        public string Name { get; set; } = string.Empty;
        public string Transport { get; set; } = "http";
        public string Url { get; set; } = string.Empty;
        public string? Command { get; set; }
        public string ArgsText { get; set; } = string.Empty;
        public string EnvText { get; set; } = string.Empty;
        public string? WorkingDirectory { get; set; }
        public bool Enabled { get; set; } = true;
        public string? Description { get; set; }
        public string? CredentialRef { get; set; }
        public int TimeoutSeconds { get; set; }
        public string ToolAllowlistText { get; set; } = string.Empty;
        public string ToolDenylistText { get; set; } = string.Empty;
        public string AuthMode { get; set; } = string.Empty;
        public string? AuthToken { get; set; }
        public bool AllowEgress { get; set; }
        public IntegrationOAuthForm? OAuth { get; set; }
    }

    public sealed class IntegrationOAuthForm
    {
        public string TokenUrl { get; set; } = string.Empty;
        public string ClientId { get; set; } = string.Empty;
