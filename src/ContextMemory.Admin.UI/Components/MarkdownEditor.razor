@using Markdig

<div class="kx-md-editor">
    <div class="kx-md-toolbar">
        <div class="kx-md-tools" role="toolbar" aria-label="Markdown formatting">
            <div class="kx-md-group">
                <button type="button" class="kx-md-btn" title="Bold" aria-label="Bold" @onclick='() => Wrap("**", "**")'>
                    <i class="fas fa-bold" aria-hidden="true"></i>
                </button>
                <button type="button" class="kx-md-btn" title="Italic" aria-label="Italic" @onclick='() => Wrap("*", "*")'>
                    <i class="fas fa-italic" aria-hidden="true"></i>
                </button>
            </div>
            <div class="kx-md-group">
                <button type="button" class="kx-md-btn" title="Heading" aria-label="Heading" @onclick='() => Prefix("## ")'>
                    <i class="fas fa-heading" aria-hidden="true"></i>
                </button>
                <button type="button" class="kx-md-btn" title="Bullet list" aria-label="Bullet list" @onclick='() => Prefix("- ")'>
                    <i class="fas fa-list-ul" aria-hidden="true"></i>
                </button>
            </div>
            <div class="kx-md-group">
                <button type="button" class="kx-md-btn" title="Inline code" aria-label="Inline code" @onclick='() => Wrap("`", "`")'>
                    <i class="fas fa-code" aria-hidden="true"></i>
                </button>
                <button type="button" class="kx-md-btn" title="Link" aria-label="Link" @onclick="InsertLink">
                    <i class="fas fa-link" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div class="kx-md-tabs" role="tablist" aria-label="Editor mode">
            <button type="button"
                    role="tab"
                    class="kx-md-tab @(_tab == "write" ? "is-active" : null)"
                    aria-selected="@(_tab == "write")"
                    @onclick='() => _tab = "write"'>Write</button>
            <button type="button"
                    role="tab"
                    class="kx-md-tab @(_tab == "preview" ? "is-active" : null)"
                    aria-selected="@(_tab == "preview")"
                    @onclick='() => _tab = "preview"'>Preview</button>
        </div>
    </div>

    @if (_tab == "write")
    {
        <textarea class="form-control kx-md-textarea"
                  rows="@Rows"
                  value="@Value"
                  @oninput="OnInput"
                  placeholder="@Placeholder"></textarea>
    }
    else
    {
        <div class="kx-md-preview kx-docs-body">
            @((MarkupString)ToHtml(Value))
        </div>
    }
</div>

@code {
    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UseBootstrap()
        .Build();

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 12;
    [Parameter] public string Placeholder { get; set; } = "Write markdown…";

    private string _tab = "write";

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task Wrap(string before, string after)
    {
        Value = $"{Value}{before}text{after}";
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task Prefix(string prefix)
    {
        Value = string.IsNullOrEmpty(Value) ? $"{prefix}" : $"{Value}\n{prefix}";
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task InsertLink()
    {
        Value = $"{Value}[label](https://)";
        await ValueChanged.InvokeAsync(Value);
    }

    private static string ToHtml(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return "<p class=\"text-muted\">Nothing to preview.</p>";
        return Markdown.ToHtml(markdown, Pipeline);
    }
}
