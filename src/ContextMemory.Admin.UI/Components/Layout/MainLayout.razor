@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="kx-shell">
    <aside class="kx-sidebar" aria-label="Primary">
        <a class="kx-brand" href="/" @onclick="CloseOverlayAsync">
            <span class="kx-brand-mark">Kortex<span>io</span></span>
            <span class="kx-brand-sub">ContextMemory Admin</span>
        </a>

        <nav class="kx-nav">
            <div class="kx-nav-section">
                <div class="kx-nav-label">Setup</div>
                <NavLink class="kx-nav-link" href="/settings" @onclick="CloseOverlayAsync">
                    <i class="fas fa-plug"></i> Connection
                </NavLink>
                <NavLink class="kx-nav-link" href="/apps/new" @onclick="CloseOverlayAsync">
                    <i class="fas fa-plus"></i> New app
                </NavLink>
                <NavLink class="kx-nav-link" href="/chat" @onclick="CloseOverlayAsync">
                    <i class="fas fa-comments"></i> Chat Lab
                </NavLink>
            </div>

            <div class="kx-nav-section">
                <div class="kx-nav-label">Activity</div>
                <NavLink class="kx-nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseOverlayAsync">
                    <i class="fas fa-th-large"></i> Applications
                </NavLink>
                <NavLink class="kx-nav-link" href="/skills" @onclick="CloseOverlayAsync">
                    <i class="fas fa-magic"></i> Skills
                </NavLink>
            </div>

            <div class="kx-nav-section">
                <div class="kx-nav-label">Account</div>
                <NavLink class="kx-nav-link" href="/settings" @onclick="CloseOverlayAsync">
                    <i class="fas fa-cog"></i> Settings
                </NavLink>
            </div>
        </nav>

        <div class="kx-sidebar-foot">
            Memory you can open as a wiki.
        </div>
    </aside>

    <div class="kx-overlay" @onclick="CloseOverlayAsync"></div>

    <div class="kx-main">
        <header class="kx-topbar">
            <button type="button" class="kx-topbar-toggle" title="Toggle sidebar" @onclick="ToggleSidebarAsync">
                <i class="fas fa-bars"></i>
            </button>

            @if (_apps.Count > 0)
            {
                <div class="kx-app-switch">
                    <select @onchange="OnAppSelected" title="Open app">
                        <option value="">Jump to app…</option>
                        @foreach (var app in _apps)
                        {
                            <option value="@app.AppId">@app.AppId</option>
                        }
                    </select>
                </div>
            }

            <div class="kx-topbar-spacer"></div>

            <NavLink class="btn btn-sm btn-outline-secondary" href="/settings">
                <i class="fas fa-cog"></i> Settings
            </NavLink>
        </header>

        <main class="kx-content">
            @if (!_sessionLoaded)
            {
                <div class="alert alert-light">
                    <i class="fas fa-spinner fa-spin"></i> Loading connection settings…
                </div>
            }
            @Body
        </main>
    </div>
</div>

@code {
    [Inject] private AdminSession Session { get; set; } = default!;
    [Inject] private AdminApiClient Api { get; set; } = default!;

    private bool _sessionLoaded;
    private IReadOnlyList<AdminAppListItem> _apps = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionLoaded)
            return;

        _sessionLoaded = true;
        Session.Changed += HandleSessionChanged;
        await Session.InitializeAsync();
        await RefreshAppsAsync();
        StateHasChanged();
    }

    private async void HandleSessionChanged() => await InvokeAsync(async () =>
    {
        await RefreshAppsAsync();
        StateHasChanged();
    });

    private async Task RefreshAppsAsync()
    {
        if (!Session.IsConfigured)
        {
            _apps = [];
            return;
        }

        try
        {
            _apps = await Api.GetAppsAsync();
        }
        catch
        {
            _apps = [];
        }
    }

    private void OnAppSelected(ChangeEventArgs e)
    {
        var appId = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(appId))
            return;
        Nav.NavigateTo($"/apps/{Uri.EscapeDataString(appId)}/config");
    }

    private async Task ToggleSidebarAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("contextMemoryAdmin.toggleSidebar");
        }
        catch (JSException)
        {
        }
    }

    private async Task CloseOverlayAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("contextMemoryAdmin.closeSidebarOverlay");
        }
        catch (JSException)
        {
        }
    }

    public void Dispose() => Session.Changed -= HandleSessionChanged;
}
