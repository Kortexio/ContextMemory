@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="kx-shell">
    <aside class="kx-sidebar" aria-label="Primary">
        <a class="kx-brand" href="@(string.IsNullOrEmpty(_activeAppId) ? "/" : $"/apps/{Uri.EscapeDataString(_activeAppId)}")" @onclick="CloseOverlayAsync">
            <span class="kx-brand-mark">Kortex<span>io</span></span>
            <span class="kx-brand-sub">
                @if (string.IsNullOrEmpty(_activeAppId))
                {
                    <text>ContextMemory</text>
                }
                else
                {
                    <text>App · @_activeAppId</text>
                }
            </span>
        </a>

        <nav class="kx-nav">
            @if (string.IsNullOrEmpty(_activeAppId))
            {
                <div class="kx-nav-section">
                    <div class="kx-nav-label">Setup</div>
                    <NavLink class="kx-nav-link" href="/apps/new" @onclick="CloseOverlayAsync">
                        <i class="fas fa-plus-circle"></i> New app
                    </NavLink>
                </div>

                <div class="kx-nav-section">
                    <div class="kx-nav-label">Activity</div>
                    <NavLink class="kx-nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseOverlayAsync">
                        <i class="fas fa-chart-pie"></i> Dashboard
                    </NavLink>
                    <NavLink class="kx-nav-link" href="/skills" @onclick="CloseOverlayAsync">
                        <i class="fas fa-magic"></i> Skills &amp; Guardrails
                    </NavLink>
                </div>

                <div class="kx-nav-section">
                    <div class="kx-nav-label">Account</div>
                    <NavLink class="kx-nav-link" href="/settings" @onclick="CloseOverlayAsync">
                        <i class="fas fa-cog"></i> Settings
                    </NavLink>
                </div>

                <div class="kx-nav-section">
                    <div class="kx-nav-label">Learn</div>
                    <NavLink class="kx-nav-link" href="/docs" @onclick="CloseOverlayAsync">
                        <i class="fas fa-book"></i> Docs
                    </NavLink>
                </div>
            }
            else
            {
                <div class="kx-nav-section">
                    <NavLink class="kx-nav-link" href="/" @onclick="CloseOverlayAsync">
                        <i class="fas fa-arrow-left"></i> All apps
                    </NavLink>
                </div>

                <div class="kx-nav-section">
                    <div class="kx-nav-label">Overview</div>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}")" Match="NavLinkMatch.All" @onclick="CloseOverlayAsync">
                        <i class="fas fa-chart-pie"></i> Dashboard
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/credentials")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-key"></i> API key
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/playground")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-flask"></i> Playground
                    </NavLink>
                </div>

                <div class="kx-nav-section">
                    <div class="kx-nav-label">Configuration</div>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/config/llm")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-microchip"></i> LLM
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/config/memory")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-book-open"></i> Memory &amp; wiki
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/config/web-search")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-search"></i> Web search
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/config/rate-limits")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-tachometer-alt"></i> Rate limits
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/config/persona")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-user"></i> Persona &amp; rules
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/config/agentic")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-robot"></i> Agentic
                    </NavLink>
                    <NavLink class="kx-nav-link" href="@($"/apps/{_activeAppId}/policies")" @onclick="CloseOverlayAsync">
                        <i class="fas fa-magic"></i> Skills &amp; guardrails
                    </NavLink>
                </div>
            }
        </nav>

        <div class="kx-sidebar-usage">
            <div class="kx-sidebar-usage-title">Workspace</div>
            @if (!string.IsNullOrEmpty(_activeAppId))
            {
                <div class="kx-sidebar-usage-row">
                    <span>Active app</span>
                    <strong title="@_activeAppId">@_activeAppId</strong>
                </div>
            }
            else if (Session.IsConfigured)
            {
                <div class="kx-sidebar-usage-row">
                    <span>Apps</span>
                    <strong>@_apps.Count</strong>
                </div>
                <div class="kx-sidebar-usage-row">
                    <span>API</span>
                    <strong class="kx-ok">Connected</strong>
                </div>
            }
            else
            {
                <div class="kx-sidebar-usage-row">
                    <span>API</span>
                    <strong class="kx-warn">Not set</strong>
                </div>
                <NavLink class="kx-sidebar-usage-cta" href="/settings" @onclick="CloseOverlayAsync">Connect now</NavLink>
            }
            @if (string.IsNullOrEmpty(_activeAppId))
            {
                <NavLink class="kx-sidebar-usage-cta" href="/docs" @onclick="CloseOverlayAsync">Open docs</NavLink>
            }
        </div>
    </aside>

    <div class="kx-overlay" @onclick="CloseOverlayAsync"></div>

    <div class="kx-main">
        <header class="kx-topbar">
            <button type="button" class="kx-topbar-toggle" title="Toggle sidebar" @onclick="ToggleSidebarAsync">
                <i class="fas fa-bars"></i>
            </button>

            @if (_apps.Count > 0)
            {
                <div class="kx-app-switch">
                    <select value="@_activeAppId" @onchange="OnAppSelected" title="Open app">
                        <option value="">All apps…</option>
                        @foreach (var app in _apps)
                        {
                            <option value="@app.AppId">@app.AppId</option>
                        }
                    </select>
                </div>
            }

            <div class="kx-topbar-spacer"></div>

            @if (!string.IsNullOrEmpty(_activeAppId))
            {
                <NavLink class="kx-topbar-btn" href="@($"/apps/{_activeAppId}/playground")">
                    <i class="fas fa-flask"></i> Playground
                </NavLink>
            }
            else
            {
                <NavLink class="kx-topbar-btn kx-topbar-btn-primary" href="/apps/new">
                    <i class="fas fa-plus"></i> New app
                </NavLink>
            }
        </header>

        <main class="kx-content">
            @if (!_sessionLoaded)
            {
                <div class="kx-loading-banner">
                    <i class="fas fa-spinner fa-spin"></i> Loading connection settings…
                </div>
            }
            @Body
        </main>
    </div>
</div>

@code {
    [Inject] private AdminSession Session { get; set; } = default!;
    [Inject] private AdminApiClient Api { get; set; } = default!;

    private bool _sessionLoaded;
    private string _activeAppId = string.Empty;
    private IReadOnlyList<AdminAppListItem> _apps = [];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RefreshActiveAppId();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionLoaded)
            return;

        _sessionLoaded = true;
        Session.Changed += HandleSessionChanged;
        await Session.InitializeAsync();
        await RefreshAppsAsync();
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RefreshActiveAppId();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshActiveAppId()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2
            && parts[0].Equals("apps", StringComparison.OrdinalIgnoreCase)
            && !parts[1].Equals("new", StringComparison.OrdinalIgnoreCase))
        {
            _activeAppId = Uri.UnescapeDataString(parts[1]);
        }
        else
        {
            _activeAppId = string.Empty;
        }
    }

    private async void HandleSessionChanged() => await InvokeAsync(async () =>
    {
        await RefreshAppsAsync();
        StateHasChanged();
    });

    private async Task RefreshAppsAsync()
    {
        if (!Session.IsConfigured)
        {
            _apps = [];
            return;
        }

        try
        {
            _apps = await Api.GetAppsAsync();
        }
        catch
        {
            _apps = [];
        }
    }

    private void OnAppSelected(ChangeEventArgs e)
    {
        var appId = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(appId))
        {
            Nav.NavigateTo("/");
            return;
        }

        Nav.NavigateTo($"/apps/{Uri.EscapeDataString(appId)}");
    }

    private async Task ToggleSidebarAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("contextMemoryAdmin.toggleSidebar");
        }
        catch (JSException)
        {
        }
    }

    private async Task CloseOverlayAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("contextMemoryAdmin.closeSidebarOverlay");
        }
        catch (JSException)
        {
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Session.Changed -= HandleSessionChanged;
    }
}
