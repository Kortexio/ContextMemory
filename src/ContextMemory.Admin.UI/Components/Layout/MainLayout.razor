@inherits LayoutComponentBase
@inject IJSRuntime Js

<div class="wrapper">
    <nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" href="#" role="button" title="Toggle sidebar"
                   @onclick="ToggleSidebarAsync" @onclick:preventDefault>
                    <i class="fas fa-bars"></i>
                </a>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <NavLink class="nav-link" href="/">Applications</NavLink>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <NavLink class="nav-link" href="/chat">Chat Lab</NavLink>
            </li>
        </ul>
        <ul class="navbar-nav ms-auto">
            <li class="nav-item">
                <NavLink class="nav-link" href="/settings"><i class="fas fa-cog"></i> Settings</NavLink>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="/" class="brand-link text-center">
            <span class="brand-text font-weight-light">ContextMemory Admin</span>
        </a>
        <div class="sidebar">
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" role="menu">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseOverlayAsync">
                            <i class="nav-icon fas fa-th"></i>
                            <p>Applications</p>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/apps/new" @onclick="CloseOverlayAsync">
                            <i class="nav-icon fas fa-plus-circle"></i>
                            <p>New application</p>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/chat" @onclick="CloseOverlayAsync">
                            <i class="nav-icon fas fa-comments"></i>
                            <p>Chat Lab</p>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/settings" @onclick="CloseOverlayAsync">
                            <i class="nav-icon fas fa-key"></i>
                            <p>Connection</p>
                        </NavLink>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="sidebar-overlay" @onclick="CloseOverlayAsync"></div>

    <div class="content-wrapper">
        <section class="content pt-3">
            <div class="container-fluid">
                @if (!_sessionLoaded)
                {
                    <div class="alert alert-light border">
                        <i class="fas fa-spinner fa-spin"></i> Loading connection settings…
                    </div>
                }
                else if (!Session.IsConfigured)
                {
                    <div class="alert alert-warning">
                        <strong>Not connected.</strong>
                        Set the API URL and Master Key in <NavLink href="/settings">Settings</NavLink>,
                        then click <em>Test connection</em>.
                    </div>
                }
                @Body
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>ContextMemory</strong> Admin Console
    </footer>
</div>

@code {
    [Inject] private AdminSession Session { get; set; } = default!;

    private bool _sessionLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionLoaded)
            return;

        _sessionLoaded = true;
        await Session.InitializeAsync();
        StateHasChanged();
    }

    private async Task ToggleSidebarAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("contextMemoryAdmin.toggleSidebar");
        }
        catch (JSException)
        {
        }
    }

    private async Task CloseOverlayAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("contextMemoryAdmin.closeSidebarOverlay");
        }
        catch (JSException)
        {
        }
    }
}
