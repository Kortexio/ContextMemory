@page "/apps/{AppId}/config"
@page "/apps/{AppId}/config/llm"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout
@inherits AppConfigSectionBase
@using ContextMemory.Core.Models

<PageTitle>LLM · @AppId</PageTitle>

<div class="kx-page-header">
    <div>
        <h1 class="kx-page-title">LLM</h1>
        <p class="kx-page-lead">Model, backend, sampling defaults, and chat history for this tenant.</p>
    </div>
    <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@(Saving || Loading)">Reload</button>
</div>

@if (Loading)
{
    <div class="kx-loading-banner"><i class="fas fa-spinner fa-spin"></i> Loading…</div>
}
else if (LoadError is not null)
{
    <div class="alert alert-warning">@LoadError</div>
}
else
{
    <div class="kx-panel">
        <div class="kx-panel-body">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <div class="kx-section-title">Connection</div>
                <div class="form-group">
                    <label>Default language</label>
                    <InputText class="form-control" @bind-Value="_form.DefaultLanguage" />
                    <FieldHelp>BCP-47 locale injected into prompts (e.g. en-US).</FieldHelp>
                </div>
                <ModelPicker @bind-Value="_form.LlmModel" Label="LLM model" AppId="@AppId" InputId="llmModel">
                    <FieldHelp>Model id for this tenant. Must exist on the configured backend.</FieldHelp>
                </ModelPicker>
                <div class="form-group">
                    <label>Backend</label>
                    <InputSelect class="form-control" @bind-Value="_form.LlmBackend">
                        <option value="ollama">ollama (OpenAI /v1 on OllamaEndpoint)</option>
                        <option value="vllm">vllm</option>
                        <option value="lmstudio">lmstudio</option>
                        <option value="openai">openai</option>
                        <option value="openai-compatible">openai-compatible</option>
                        <option value="custom">custom (alias of openai-compatible)</option>
                        <option value="ollama-native">ollama-native (/api/chat fallback)</option>
                    </InputSelect>
                </div>
                <div class="form-group">
                    <label>LLM endpoint URL (optional)</label>
                    <InputText class="form-control" @bind-Value="_form.LlmEndpoint" placeholder="Leave empty for host default" />
                </div>
                <div class="form-group">
                    <label>LLM API key (optional)</label>
                    <InputText class="form-control" type="password" @bind-Value="_form.LlmApiKey" />
                </div>
                <div class="form-group">
                    <label>Max history messages</label>
                    <InputNumber class="form-control" @bind-Value="_form.MaxHistoryMessages" />
                    <FieldHelp>How many prior chat messages are kept in the request (plus system prompt).</FieldHelp>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="streamingEnabled" @bind-Value="_form.StreamingEnabled" />
                    <label class="form-check-label" for="streamingEnabled">Streaming enabled</label>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="llmThinkEnabled" @bind-Value="_form.LlmThinkEnabled" />
                    <label class="form-check-label" for="llmThinkEnabled">Enable model thinking</label>
                    <FieldHelp>
                        Off by default. When on, thinking-capable models (e.g. Qwen3) may spend many tokens before the answer.
                        Requires <code>reasoning_effort</code> on OpenAI <code>/v1</code> or <code>think</code> on Ollama native.
                        Leave off to avoid empty/truncated finals when the model only fills the thinking channel.
                    </FieldHelp>
                </div>

                <div class="kx-section-title">Generation defaults</div>
                <p class="text-muted small mb-3">
                    Values sent on every chat/generate for this app unless the client overrides them in the request body.
                    Leave blank to use the model/server default.
                </p>
                <div class="form-row">
                    <div class="col-md-6 form-group">
                        <label>temperature</label>
                        <InputNumber class="form-control" @bind-Value="_form.Temperature" step="0.05" />
                        <FieldHelp>Sampling temperature (e.g. <code>0.2</code> focused, <code>0.7</code> creative). Maps to OpenAI <code>temperature</code>.</FieldHelp>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>top_p</label>
                        <InputNumber class="form-control" @bind-Value="_form.TopP" step="0.05" />
                        <FieldHelp>Nucleus sampling. OpenAI <code>top_p</code> / Ollama <code>top_p</code>.</FieldHelp>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6 form-group">
                        <label>top_k</label>
                        <InputNumber class="form-control" @bind-Value="_form.TopK" />
                        <FieldHelp>Ollama <code>top_k</code> (also forwarded via <code>options</code> on Ollama <code>/v1</code>).</FieldHelp>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>num_ctx</label>
                        <InputNumber class="form-control" @bind-Value="_form.NumCtx" />
                        <FieldHelp>
                            Context window size (Ollama <code>num_ctx</code>). Raise for agentic/MCP turns (e.g. <code>32768</code>).
                            When set with backend <code>ollama</code>, the gateway automatically uses <code>ollama-native</code>
                            (<code>/api/chat</code>) because Ollama <code>/v1</code> ignores <code>options.num_ctx</code>.
                            Other OpenAI-compatible servers ignore this field — set context at server load time.
                        </FieldHelp>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6 form-group">
                        <label>num_predict / max_tokens</label>
                        <InputNumber class="form-control" @bind-Value="_form.NumPredict" />
                        <FieldHelp>
                            Max tokens to generate. Ollama <code>num_predict</code> → OpenAI <code>max_tokens</code>.
                            Too low causes mid-sentence cutoffs.
                        </FieldHelp>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>repeat_penalty</label>
                        <InputNumber class="form-control" @bind-Value="_form.RepeatPenalty" step="0.05" />
                        <FieldHelp>Ollama <code>repeat_penalty</code> (e.g. <code>1.1</code>). Native / <code>options</code> on Ollama <code>/v1</code>.</FieldHelp>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6 form-group">
                        <label>seed</label>
                        <InputNumber class="form-control" @bind-Value="_form.Seed" />
                        <FieldHelp>Optional deterministic seed (OpenAI <code>seed</code> / Ollama <code>seed</code>).</FieldHelp>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>mirostat</label>
                        <InputNumber class="form-control" @bind-Value="_form.Mirostat" />
                        <FieldHelp>Ollama Mirostat mode (<code>0</code> off, <code>1</code>/<code>2</code>). Leave blank for default.</FieldHelp>
                    </div>
                </div>
                <div class="form-group">
                    <label>tfs_z</label>
                    <InputNumber class="form-control" @bind-Value="_form.TfsZ" step="0.05" />
                    <FieldHelp>Ollama Tail Free Sampling (<code>tfs_z</code>). Rarely needed.</FieldHelp>
                </div>
                <div class="form-group">
                    <label>stop (comma-separated)</label>
                    <InputText class="form-control" @bind-Value="_form.StopCsv" placeholder="e.g. ###,END" />
                    <FieldHelp>Exact stop strings sent as <code>stop</code> / Ollama <code>options.stop</code>.</FieldHelp>
                </div>
                <div class="form-group">
                    <label>keep_alive</label>
                    <InputText class="form-control" @bind-Value="_form.KeepAlive" placeholder="e.g. 5m or -1" />
                    <FieldHelp>How long Ollama keeps the model loaded (<code>keep_alive</code>). Empty = server default.</FieldHelp>
                </div>
                <div class="form-group">
                    <label>format</label>
                    <InputText class="form-control" @bind-Value="_form.Format" placeholder="e.g. json" />
                    <FieldHelp>
                        Ollama response <code>format</code> (e.g. <code>json</code>). Empty = free text.
                        <strong>Warning:</strong> <code>format=json</code> conflicts with agentic tool calling
                        (mapped to <code>response_format</code>) and is ignored on agentic turns that include tools.
                    </FieldHelp>
                </div>

                @if (!string.IsNullOrWhiteSpace(_form.Format)
                     && _form.Format.Contains("json", StringComparison.OrdinalIgnoreCase)
                     && string.Equals(_form.LlmBackend, "ollama", StringComparison.OrdinalIgnoreCase)
                     && _form.NumCtx is > 0)
                {
                    <div class="alert alert-warning small">
                        Tenant has <code>format</code> containing json and <code>num_ctx</code> set.
                        Agentic turns will ignore <code>format</code> when tools are present, and Ollama will use
                        native <code>/api/chat</code> so <code>num_ctx</code> applies.
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_form.Format)
                         && _form.Format.Contains("json", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="alert alert-warning small">
                        <code>format=json</code> fights native <code>tool_calls</code>. It is cleared automatically
                        during agentic iterations that send tools.
                    </div>
                }
                else if (string.Equals(_form.LlmBackend, "ollama", StringComparison.OrdinalIgnoreCase)
                         && _form.NumCtx is > 0)
                {
                    <div class="alert alert-info small">
                        <code>num_ctx=@(_form.NumCtx)</code> with backend <code>ollama</code>:
                        runtime switches to <code>ollama-native</code> so context is applied.
                    </div>
                }

                @if (Message is not null) { <div class="alert alert-success">@Message</div> }
                @if (Error is not null) { <div class="alert alert-danger">@Error</div> }

                <div class="kx-section-save">
                    <button class="btn btn-primary" type="submit" disabled="@Saving">@(Saving ? "Saving…" : "Save LLM")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly LlmForm _form = new();

    protected override void OnConfigLoaded(AppRuntimeConfigDto config)
    {
        _form.DefaultLanguage = config.DefaultLanguage;
        _form.LlmModel = config.LlmModel;
        _form.LlmBackend = config.LlmBackend;
        _form.LlmEndpoint = config.LlmEndpoint ?? string.Empty;
        _form.LlmApiKey = config.LlmApiKey ?? string.Empty;
        _form.MaxHistoryMessages = config.MaxHistoryMessages;
        _form.StreamingEnabled = config.StreamingEnabled;
        _form.LlmThinkEnabled = config.LlmThinkEnabled;

        var o = config.LlmOptions;
        _form.Temperature = o?.Temperature;
        _form.TopP = o?.TopP;
        _form.TopK = o?.TopK;
        _form.NumCtx = o?.NumCtx;
        _form.NumPredict = o?.NumPredict;
        _form.RepeatPenalty = o?.RepeatPenalty;
        _form.Seed = o?.Seed;
        _form.Mirostat = o?.Mirostat;
        _form.TfsZ = o?.TfsZ;
        _form.StopCsv = o?.Stop is { Count: > 0 } ? string.Join(", ", o.Stop) : string.Empty;
        _form.KeepAlive = o?.KeepAlive ?? string.Empty;
        _form.Format = o?.Format ?? string.Empty;
    }

    protected override AppConfigPatchRequest BuildPatch() => new()
    {
        DefaultLanguage = _form.DefaultLanguage,
        LlmModel = _form.LlmModel,
        LlmBackend = _form.LlmBackend,
        LlmEndpoint = _form.LlmEndpoint ?? string.Empty,
        LlmApiKey = _form.LlmApiKey ?? string.Empty,
        MaxHistoryMessages = _form.MaxHistoryMessages,
        StreamingEnabled = _form.StreamingEnabled,
        LlmThinkEnabled = _form.LlmThinkEnabled,
        LlmOptions = BuildLlmOptions()
    };

    private LlmGenerationConfig BuildLlmOptions()
    {
        var stop = ParseStop(_form.StopCsv);
        return new LlmGenerationConfig
        {
            Temperature = _form.Temperature,
            TopP = _form.TopP,
            TopK = _form.TopK,
            NumCtx = _form.NumCtx,
            NumPredict = _form.NumPredict,
            RepeatPenalty = _form.RepeatPenalty,
            Seed = _form.Seed,
            Mirostat = _form.Mirostat,
            TfsZ = _form.TfsZ,
            Stop = stop,
            KeepAlive = string.IsNullOrWhiteSpace(_form.KeepAlive) ? null : _form.KeepAlive.Trim(),
            Format = string.IsNullOrWhiteSpace(_form.Format) ? null : _form.Format.Trim()
        };
    }

    private static List<string>? ParseStop(string? csv)
    {
        if (string.IsNullOrWhiteSpace(csv))
            return null;
        var list = csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => s.Length > 0)
            .ToList();
        return list.Count == 0 ? null : list;
    }

    private sealed class LlmForm
    {
        public string DefaultLanguage { get; set; } = "en-US";
        public string LlmModel { get; set; } = "qwen3.5:9b";
        public string LlmBackend { get; set; } = "ollama";
        public string LlmEndpoint { get; set; } = string.Empty;
        public string LlmApiKey { get; set; } = string.Empty;
        public int MaxHistoryMessages { get; set; } = 20;
        public bool StreamingEnabled { get; set; } = true;
        public bool LlmThinkEnabled { get; set; }
        public float? Temperature { get; set; }
        public float? TopP { get; set; }
        public int? TopK { get; set; }
        public int? NumCtx { get; set; }
        public int? NumPredict { get; set; }
        public float? RepeatPenalty { get; set; }
        public int? Seed { get; set; }
        public int? Mirostat { get; set; }
        public float? TfsZ { get; set; }
        public string StopCsv { get; set; } = string.Empty;
        public string KeepAlive { get; set; } = string.Empty;
        public string Format { get; set; } = string.Empty;
    }
}
