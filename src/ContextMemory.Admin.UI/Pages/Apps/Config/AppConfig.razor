@page "/apps/{AppId}/config"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout
@using ContextMemory.Admin.UI.Components
@using static ContextMemory.Admin.UI.Components.AgenticConfigEditor

<PageTitle>Config - @AppId</PageTitle>

<div class="kx-breadcrumb">
    <NavLink href="/">Applications</NavLink>
    <span class="text-muted"> / </span>
    <NavLink href="@($"/apps/{AppId}")">@AppId</NavLink>
    <span class="text-muted"> / </span>
    <span>Config</span>
</div>

<div class="kx-page-header">
    <div>
        <h1 class="kx-page-title">Runtime config</h1>
        <p class="kx-page-lead">LLM, wiki memory, web search, and agentic settings for <code>@AppId</code>.</p>
    </div>
    <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@(_saving || _loading)">Reload</button>
</div>

@if (_loading)
{
    <div class="alert alert-info"><i class="fas fa-spinner fa-spin"></i> Loading configuration…</div>
}
else
{
    <div class="kx-panel">
        <div class="kx-panel-body">
            @if (_loadError is not null)
            {
                <div class="alert alert-warning">@_loadError</div>
            }

            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <div class="kx-config-cols">
                    <div>
                        <div class="kx-section-title">LLM</div>
                        <div class="form-group">
                            <label>Default language</label>
                            <InputText class="form-control" @bind-Value="_form.DefaultLanguage" />
                            <FieldHelp>BCP-47 locale injected into prompts (e.g. en-US).</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>LLM model</label>
                            <InputText class="form-control" @bind-Value="_form.LlmModel" />
                            <FieldHelp>Model id for this tenant. Must exist on the configured backend.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Backend</label>
                            <InputSelect class="form-control" @bind-Value="_form.LlmBackend">
                                <option value="ollama">ollama (OpenAI /v1 on OllamaEndpoint)</option>
                                <option value="vllm">vllm</option>
                                <option value="lmstudio">lmstudio</option>
                                <option value="openai">openai</option>
                                <option value="openai-compatible">openai-compatible</option>
                                <option value="custom">custom (alias of openai-compatible)</option>
                                <option value="ollama-native">ollama-native (/api/chat fallback)</option>
                            </InputSelect>
                            <FieldHelp>
                                Backend protocol. Default <code>ollama</code> uses OpenAI-compatible <code>/v1</code> against
                                <code>OllamaEndpoint</code>. Use <code>vllm</code> / <code>openai-compatible</code> with a Base URL for vLLM, LiteLLM, Azure OpenAI, etc.
                                Prefer client API <code>POST /v1/chat/completions</code>.
                            </FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>LLM endpoint URL (optional)</label>
                            <InputText class="form-control" @bind-Value="_form.LlmEndpoint" placeholder="Leave empty for host default" />
                            <FieldHelp>
                                Per-app override of the backend base URL.
                                Empty = API host defaults (<code>OllamaEndpoint</code> / <code>LmStudioEndpoint</code> / <code>OpenAiEndpoint</code>).
                                OpenAI-compatible URLs get <code>/v1</code> appended when missing.
                            </FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>LLM API key (optional)</label>
                            <InputText class="form-control" type="password" @bind-Value="_form.LlmApiKey" />
                            <FieldHelp>Per-app key for OpenAI-compatible backends. Empty = host <code>OpenAiApiKey</code>.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Max history messages</label>
                            <InputNumber class="form-control" @bind-Value="_form.MaxHistoryMessages" />
                            <FieldHelp>How many recent chat turns are kept in the prompt (session wiki is separate).</FieldHelp>
                        </div>
                        <div class="form-check mb-3">
                            <InputCheckbox class="form-check-input" id="streamingEnabled" @bind-Value="_form.StreamingEnabled" />
                            <label class="form-check-label" for="streamingEnabled">Streaming enabled</label>
                            <FieldHelp>Allow NDJSON token streaming on <code>/api/chat</code>.</FieldHelp>
                        </div>
                    </div>
                    <div>
                        <div class="kx-section-title">Session wiki</div>
                        <div class="form-group">
                            <label>Max wiki context chars</label>
                            <InputNumber class="form-control" @bind-Value="_form.MaxWikiContextChars" />
                            <FieldHelp>Budget for compiled per-session wiki text injected into each turn. <code>0</code> = API default.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Compaction threshold (bytes)</label>
                            <InputNumber class="form-control" @bind-Value="_form.WikiCompactionThresholdBytes" />
                            <FieldHelp>When session wiki files exceed this size, the maintainer compacts older pages.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Compaction min pages</label>
                            <InputNumber class="form-control" @bind-Value="_form.WikiCompactionMinPages" />
                            <FieldHelp>Minimum page count before compaction is allowed to run.</FieldHelp>
                        </div>

                        <div class="kx-section-title">Global Wiki</div>
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" id="globalWikiEnabled" @bind-Value="_form.GlobalWikiEnabled" />
                            <label class="form-check-label" for="globalWikiEnabled">Enable Global Wiki (<code>wiki_search</code>)</label>
                            <FieldHelp>
                                Exposes the built-in tool so the agent can search app-scoped documents ingested via
                                <code>/apps/&#123;id&#125;/wiki/…</code>.
                            </FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Max Global Wiki tool chars</label>
                            <InputNumber class="form-control" @bind-Value="_form.MaxGlobalWikiToolChars" />
                            <FieldHelp>Max characters returned by a single <code>wiki_search</code> call. <code>0</code> = service default.</FieldHelp>
                        </div>

                        <div class="kx-section-title">Web search</div>
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" id="webSearchEnabled" @bind-Value="_form.WebSearchEnabled" />
                            <label class="form-check-label" for="webSearchEnabled">Enable web search</label>
                            <FieldHelp>Optional live web lookup when the model needs fresh public info.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Mode</label>
                            <InputSelect class="form-control" @bind-Value="_form.WebSearchMode">
                                <option value="heuristic">heuristic (fast + LLM when inconclusive)</option>
                                <option value="llm">llm (always classify)</option>
                                <option value="always">always (search every turn)</option>
                                <option value="off">off</option>
                            </InputSelect>
                            <FieldHelp>When to trigger a search relative to each user turn.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Provider</label>
                            <InputSelect class="form-control" @bind-Value="_form.WebSearchProvider">
                                <option value="tavily">tavily</option>
                                <option value="brave">brave</option>
                            </InputSelect>
                            <FieldHelp>API keys are configured on the API host (<code>ContextMemory:WebSearch</code>), not per app.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Max results</label>
                            <InputNumber class="form-control" @bind-Value="_form.WebSearchMaxResults" />
                            <FieldHelp>How many search hits to fetch per query.</FieldHelp>
                        </div>
                        <div class="form-group">
                            <label>Max context chars (ephemeral prompt)</label>
                            <InputNumber class="form-control" @bind-Value="_form.WebSearchMaxContextChars" />
                            <FieldHelp>How much search text may be injected into the prompt for that turn.</FieldHelp>
                        </div>
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" id="persistWeb" @bind-Value="_form.WebSearchPersistToWiki" />
                            <label class="form-check-label" for="persistWeb">Persist web facts to session wiki</label>
                            <FieldHelp>When on, useful snippets may be written into the session wiki by the maintainer.</FieldHelp>
                        </div>
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" id="logWeb" @bind-Value="_form.WebSearchLogWebSearch" />
                            <label class="form-check-label" for="logWeb">Log web searches in telemetry</label>
                        </div>
                    </div>
                </div>

                <div class="kx-section-title">Rate limits</div>
                <div class="form-row">
                    <div class="col-md-4 form-group">
                        <label>Requests / min (app)</label>
                        <InputNumber class="form-control" @bind-Value="_form.RateLimitRpm" />
                        <FieldHelp>Shared budget across all users of this app.</FieldHelp>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Requests / min (user)</label>
                        <InputNumber class="form-control" @bind-Value="_form.RateLimitUserRpm" />
                        <FieldHelp>Per <code>X-User-Id</code> budget.</FieldHelp>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Tokens / min</label>
                        <InputNumber class="form-control" @bind-Value="_form.RateLimitTpm" />
                        <FieldHelp>Approximate token throughput cap for this app.</FieldHelp>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6 form-group">
                        <label>Agentic request weight</label>
                        <InputNumber class="form-control" @bind-Value="_form.AgenticRequestWeight" />
                        <FieldHelp>Each agentic turn counts as N requests in the rate limiter (tools are heavier).</FieldHelp>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Agentic tokens / iteration</label>
                        <InputNumber class="form-control" @bind-Value="_form.AgenticTokensPerIteration" />
                        <FieldHelp>Estimated tokens charged per agentic iteration for TPM accounting.</FieldHelp>
                    </div>
                </div>

                <AgenticConfigEditor Model="_form.Agentic" />

                <div class="kx-section-title">Persona and rules (markdown)</div>
                <div class="form-group">
                    <label>Base persona</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_form.BasePersona" />
                    <FieldHelp>Core assistant identity / tone for this tenant.</FieldHelp>
                </div>
                <div class="form-group">
                    <label>Business rules</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_form.BusinessRules" />
                    <FieldHelp>Hard product or policy constraints the model must follow.</FieldHelp>
                </div>
                <div class="form-group">
                    <label>Format rules</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_form.FormatRules" />
                    <FieldHelp>Output shape preferences (lists, headings, language style).</FieldHelp>
                </div>
                <div class="form-group">
                    <label>Wiki schema</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_form.WikiSchema" />
                    <FieldHelp>Guidance for how the session wiki should be structured (page names, sections).</FieldHelp>
                </div>

                @if (_message is not null)
                {
                    <div class="alert alert-success">@_message</div>
                }
                @if (_error is not null)
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <div class="sticky-save-bar">
                    <button class="btn btn-primary" type="submit" disabled="@_saving">
                        @(_saving ? "Saving…" : "Save changes")
                    </button>
                    <span class="text-muted small ml-2">Changes apply to new requests immediately after save.</span>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private sealed class ConfigForm
    {
        public string DefaultLanguage { get; set; } = "en-US";
        public string LlmModel { get; set; } = "qwen3.5:9b";
        public string LlmBackend { get; set; } = "ollama";
        public string LlmEndpoint { get; set; } = string.Empty;
        public string LlmApiKey { get; set; } = string.Empty;
        public int MaxHistoryMessages { get; set; } = 20;
        public bool StreamingEnabled { get; set; } = true;
        public int MaxWikiContextChars { get; set; }
        public long WikiCompactionThresholdBytes { get; set; }
        public int WikiCompactionMinPages { get; set; }
        public bool GlobalWikiEnabled { get; set; } = true;
        public int MaxGlobalWikiToolChars { get; set; }
        public string BasePersona { get; set; } = string.Empty;
        public string BusinessRules { get; set; } = string.Empty;
        public string FormatRules { get; set; } = string.Empty;
        public string WikiSchema { get; set; } = string.Empty;
        public bool WebSearchEnabled { get; set; }
        public string WebSearchMode { get; set; } = "heuristic";
        public string WebSearchProvider { get; set; } = "tavily";
        public int WebSearchMaxResults { get; set; } = 5;
        public int WebSearchMaxContextChars { get; set; } = 3000;
        public bool WebSearchPersistToWiki { get; set; }
        public bool WebSearchLogWebSearch { get; set; } = true;
        public int RateLimitRpm { get; set; } = 60;
        public int RateLimitUserRpm { get; set; } = 30;
        public int RateLimitTpm { get; set; } = 100_000;
        public int AgenticRequestWeight { get; set; } = 3;
        public int AgenticTokensPerIteration { get; set; } = 500;
        public AgenticConfigForm Agentic { get; set; } = new();
    }

    [Parameter] public string AppId { get; set; } = string.Empty;
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private ChatClient ChatApi { get; set; } = default!;
    [Inject] private AdminSession Session { get; set; } = default!;

    private ConfigForm _form = new();
    private bool _loading = true;
    private bool _saving;
    private string? _message;
    private string? _error;
    private string? _loadError;
    private string? _apiKey;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsConfigured)
            await Session.InitializeAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _message = null;
        _error = null;

        if (!Session.IsConfigured)
        {
            _loadError = "Configure Settings first.";
            _loading = false;
            return;
        }

        try
        {
            var credentials = await Api.GetAppCredentialsAsync(AppId);
            if (credentials is null || string.IsNullOrWhiteSpace(credentials.ApiKey))
            {
                _loadError = "API key unavailable — could not load config via GET /apps/{id}/config.";
                return;
            }

            _apiKey = credentials.ApiKey;
            var settings = new ChatTestSettings
            {
                AppId = AppId,
                UserId = "admin-config",
                ApiKey = credentials.ApiKey,
                Model = "qwen3.5:9b"
            };

            var config = await ChatApi.GetAppConfigAsync(settings);
            if (config is null)
            {
                _loadError = "Empty config.";
                return;
            }

            _form = new ConfigForm
            {
                DefaultLanguage = config.DefaultLanguage,
                LlmModel = config.LlmModel,
                LlmBackend = config.LlmBackend,
                LlmEndpoint = config.LlmEndpoint ?? string.Empty,
                LlmApiKey = config.LlmApiKey ?? string.Empty,
                MaxHistoryMessages = config.MaxHistoryMessages,
                StreamingEnabled = config.StreamingEnabled,
                MaxWikiContextChars = config.MaxWikiContextChars,
                WikiCompactionThresholdBytes = config.WikiCompactionThresholdBytes,
                WikiCompactionMinPages = config.WikiCompactionMinPages,
                GlobalWikiEnabled = config.GlobalWikiEnabled,
                MaxGlobalWikiToolChars = config.MaxGlobalWikiToolChars,
                BasePersona = config.BasePersona,
                BusinessRules = config.BusinessRules,
                FormatRules = config.FormatRules,
                WikiSchema = config.WikiSchema,
                WebSearchEnabled = config.WebSearch?.Enabled ?? false,
                WebSearchMode = config.WebSearch?.Mode ?? "heuristic",
                WebSearchProvider = config.WebSearch?.Provider ?? "tavily",
                WebSearchMaxResults = config.WebSearch?.MaxResults ?? 5,
                WebSearchMaxContextChars = config.WebSearch?.MaxContextChars ?? 3000,
                WebSearchPersistToWiki = config.WebSearch?.PersistToWiki ?? false,
                WebSearchLogWebSearch = config.WebSearch?.LogWebSearch ?? true,
                RateLimitRpm = config.RateLimits?.RequestsPerMinute ?? 60,
                RateLimitUserRpm = config.RateLimits?.UserRequestsPerMinute ?? 30,
                RateLimitTpm = config.RateLimits?.TokensPerMinute ?? 100_000,
                AgenticRequestWeight = config.RateLimits?.AgenticRequestWeight ?? 3,
                AgenticTokensPerIteration = config.RateLimits?.AgenticTokensPerIteration ?? 500,
                Agentic = AgenticConfigForm.FromConfig(config.Agentic)
            };
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        try
        {
            var patch = new AppConfigPatchRequest
            {
                DefaultLanguage = _form.DefaultLanguage,
                LlmModel = _form.LlmModel,
                LlmBackend = _form.LlmBackend,
                LlmEndpoint = _form.LlmEndpoint ?? string.Empty,
                LlmApiKey = _form.LlmApiKey ?? string.Empty,
                MaxHistoryMessages = _form.MaxHistoryMessages,
                StreamingEnabled = _form.StreamingEnabled,
                MaxWikiContextChars = _form.MaxWikiContextChars > 0 ? _form.MaxWikiContextChars : null,
                WikiCompactionThresholdBytes = _form.WikiCompactionThresholdBytes > 0 ? _form.WikiCompactionThresholdBytes : null,
                WikiCompactionMinPages = _form.WikiCompactionMinPages > 0 ? _form.WikiCompactionMinPages : null,
                GlobalWikiEnabled = _form.GlobalWikiEnabled,
                MaxGlobalWikiToolChars = _form.MaxGlobalWikiToolChars > 0 ? _form.MaxGlobalWikiToolChars : null,
                BasePersona = _form.BasePersona,
                BusinessRules = _form.BusinessRules,
                FormatRules = _form.FormatRules,
                WikiSchema = _form.WikiSchema,
                WebSearch = new WebSearchConfigPatch
                {
                    Enabled = _form.WebSearchEnabled,
                    Mode = _form.WebSearchMode,
                    Provider = _form.WebSearchProvider,
                    MaxResults = _form.WebSearchMaxResults > 0 ? _form.WebSearchMaxResults : null,
                    MaxContextChars = _form.WebSearchMaxContextChars > 0 ? _form.WebSearchMaxContextChars : null,
                    PersistToWiki = _form.WebSearchPersistToWiki,
                    LogWebSearch = _form.WebSearchLogWebSearch
                },
                RateLimits = new RateLimitConfig
                {
                    RequestsPerMinute = _form.RateLimitRpm,
                    UserRequestsPerMinute = _form.RateLimitUserRpm,
                    TokensPerMinute = _form.RateLimitTpm,
                    AgenticRequestWeight = _form.AgenticRequestWeight,
                    AgenticTokensPerIteration = _form.AgenticTokensPerIteration
                },
                Agentic = _form.Agentic.ToConfig()
            };

            var updated = await Api.PatchConfigAsync(AppId, patch);
            _message = $"Config saved. Model: {updated?.LlmModel ?? _form.LlmModel}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
