@page "/apps/{AppId}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout

<PageTitle>@AppId - Kortexio Admin</PageTitle>

@if (_loading)
{
    <div class="alert alert-info"><i class="fas fa-spinner fa-spin"></i> Loading…</div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_stats is not null)
{
    <div class="kx-breadcrumb">
        <NavLink href="/">Applications</NavLink>
        <span class="text-muted"> / </span>
        <span>@AppId</span>
    </div>

    <div class="kx-page-header">
        <div>
            <h1 class="kx-page-title">@AppId</h1>
            <p class="kx-page-lead">Telemetry and credentials for this tenant.</p>
        </div>
        <div class="d-flex flex-wrap" style="gap:0.5rem">
            <span class="kx-badge">@(_credentials?.Source ?? "unknown")</span>
            <a class="btn btn-primary btn-sm" href="/apps/@AppId/config">Config</a>
            <a class="btn btn-outline-primary btn-sm" href="/apps/@AppId/policies">Policies</a>
            <NavLink class="btn btn-outline-secondary btn-sm" href="/chat">Chat Lab</NavLink>
        </div>
    </div>

    <div class="kx-metrics">
        <div class="kx-metric">
            <div class="kx-metric-label">Requests</div>
            <div class="kx-metric-value">@(_stats.Telemetry?.RequestsTotal ?? 0)</div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Errors</div>
            <div class="kx-metric-value">@(_stats.Telemetry?.RequestsError ?? 0)</div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Active users</div>
            <div class="kx-metric-value">@_stats.ActiveUsers</div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Avg latency</div>
            <div class="kx-metric-value">@((_stats.Telemetry?.AvgLatencyMs ?? 0).ToString("0"))<span style="font-size:0.85rem;font-weight:500"> ms</span></div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Tokens in</div>
            <div class="kx-metric-value">@(_stats.Telemetry?.TokensPrompt ?? 0)</div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Tokens out</div>
            <div class="kx-metric-value">@(_stats.Telemetry?.TokensCompletion ?? 0)</div>
        </div>
    </div>

    @if (_stats.Telemetry is { } t)
    {
        <div class="kx-panel">
            <div class="kx-panel-head"><h2>Wiki memory (last observed turn)</h2></div>
            <div class="kx-panel-body">
                <div class="kx-metrics" style="margin-bottom:0">
                    <div class="kx-metric">
                        <div class="kx-metric-label">Chars in prompt</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@t.WikiContextChars</div>
                    </div>
                    <div class="kx-metric">
                        <div class="kx-metric-label">Pages included</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@t.WikiPagesIncluded</div>
                    </div>
                    <div class="kx-metric">
                        <div class="kx-metric-label">Pages on disk</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@t.WikiPagesTotal</div>
                    </div>
                    <div class="kx-metric">
                        <div class="kx-metric-label">Compactions</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@t.WikiCompactionSuccess / @t.WikiCompactionErrors</div>
                    </div>
                </div>
                <p class="text-muted small mb-0 mt-2">Also see <code>GET /metrics</code> on the API.</p>
            </div>
        </div>
    }

    @if (_stats.Telemetry is { } ws && (ws.WebSearchTotal > 0 || ws.WebSearchSkippedTotal > 0))
    {
        <div class="kx-panel">
            <div class="kx-panel-head"><h2>Web search</h2></div>
            <div class="kx-panel-body">
                <div class="kx-metrics" style="margin-bottom:0">
                    <div class="kx-metric">
                        <div class="kx-metric-label">Searches</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@ws.WebSearchTotal</div>
                    </div>
                    <div class="kx-metric">
                        <div class="kx-metric-label">Hits</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@ws.WebSearchHits</div>
                    </div>
                    <div class="kx-metric">
                        <div class="kx-metric-label">Skipped</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@ws.WebSearchSkippedTotal</div>
                    </div>
                    <div class="kx-metric">
                        <div class="kx-metric-label">Last latency</div>
                        <div class="kx-metric-value" style="font-size:1.15rem">@ws.WebSearchLastLatencyMs.ToString("0") ms</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="kx-panel">
        <div class="kx-panel-head"><h2><i class="fas fa-key"></i> API key</h2></div>
        <div class="kx-panel-body">
            @if (_credentialsLoading)
            {
                <div class="text-muted"><i class="fas fa-spinner fa-spin"></i> Loading credentials…</div>
            }
            else if (_credentialsError is not null)
            {
                <div class="alert alert-danger mb-0">@_credentialsError</div>
            }
            else if (_credentials is not null)
            {
                @if (_rotateMessage is not null)
                {
                    <div class="alert alert-success">@_rotateMessage</div>
                }

                <div class="form-group mb-2">
                    <label>App API key</label>
                    <FieldHelp>Tenant key for <code>Authorization: Bearer</code>. Use with <code>X-App-Id: @AppId</code> on chat requests.</FieldHelp>
                    <div class="input-group">
                        <input class="form-control font-monospace" readonly
                               type="@(_showApiKey ? "text" : "password")"
                               value="@_credentials.ApiKey" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" @onclick="ToggleShowApiKey">
                                <i class="fas @(_showApiKey ? "fa-eye-slash" : "fa-eye")"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="CopyApiKeyAsync">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                </div>

                @if (_credentials.Source == "seed")
                {
                    <div class="alert alert-info mb-2">
                        App <strong>seed</strong> (appsettings). Rotation applies until the API restarts;
                        to persist, update <code>ContextMemory:Apps:@AppId:ApiKey</code>.
                    </div>
                }

                <button type="button" class="btn btn-outline-danger" @onclick="RotateApiKeyAsync" disabled="@_rotating">
                    @(_rotating ? "Rotating…" : "Generate new API key")
                </button>
                <NavLink class="btn btn-outline-primary ml-2" href="/chat">Use in Chat Lab</NavLink>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string AppId { get; set; } = string.Empty;
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private AdminSession Session { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private AppCredentialsDto? _credentials;
    private AppStatsResponse? _stats;
    private bool _loading = true;
    private bool _credentialsLoading = true;
    private bool _rotating;
    private bool _showApiKey;
    private string? _error;
    private string? _credentialsError;
    private string? _rotateMessage;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _credentialsLoading = true;
        _error = null;
        _credentialsError = null;
        _rotateMessage = null;

        if (!Session.IsConfigured)
            await Session.InitializeAsync();

        if (!Session.IsConfigured)
        {
            _error = "Configure Settings first.";
            _loading = false;
            _credentialsLoading = false;
            return;
        }

        try
        {
            _stats = await Api.GetAppStatsAsync(AppId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        try
        {
            _credentials = await Api.GetAppCredentialsAsync(AppId);
            if (_credentials is null)
                _credentialsError = "Credentials not found.";
        }
        catch (Exception ex)
        {
            _credentialsError = ex.Message;
        }
        finally
        {
            _credentialsLoading = false;
        }
    }

    private void ToggleShowApiKey() => _showApiKey = !_showApiKey;

    private async Task CopyApiKeyAsync()
    {
        if (_credentials?.ApiKey is null)
            return;
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", _credentials.ApiKey);
        _rotateMessage = "API key copied to clipboard.";
    }

    private async Task RotateApiKeyAsync()
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Generate a new API key? The previous key will stop working immediately."))
            return;

        _rotating = true;
        _rotateMessage = null;
        _credentialsError = null;
        try
        {
            _credentials = await Api.RotateAppApiKeyAsync(AppId);
            _showApiKey = true;
            _rotateMessage = _credentials.RotationPersists
                ? "New API key generated and saved."
                : "New API key generated (valid until API restart — seed app).";
        }
        catch (Exception ex)
        {
            _credentialsError = ex.Message;
        }
        finally
        {
            _rotating = false;
        }
    }
}
