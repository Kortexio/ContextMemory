@page "/apps/{AppId}/policies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout AppLayout
@using ContextMemory.Admin.UI.Components
@using ContextMemory.Admin.UI.Models
@using ContextMemory.Admin.UI.Services
@using ContextMemory.Core.Agentic
@using ContextMemory.Core.Models
@using static ContextMemory.Admin.UI.Components.AgenticConfigEditor

<PageTitle>Policies · @AppId</PageTitle>

<div class="kx-page-header">
    <div>
        <h1 class="kx-page-title">Skills &amp; guardrails</h1>
        <p class="kx-page-lead">
            Per-app policy packs for <code>@AppId</code>.
            Platform catalog: <a href="/skills">Skills &amp; Guardrails</a>.
        </p>
    </div>
    <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@(_saving || _loading)">Reload</button>
</div>

@if (_loading)
{
    <div class="kx-loading-banner"><i class="fas fa-spinner fa-spin"></i> Loading policies…</div>
}
else if (_loadError is not null)
{
    <div class="alert alert-warning">@_loadError</div>
}
else
{
    <div class="kx-panel">
        <div class="kx-panel-head">
            <div>
                <h2>Selection mode</h2>
                <p>Inherit platform defaults or pin a custom set for this tenant.</p>
            </div>
        </div>
        <div class="kx-panel-body">
            @if (_message is not null)
            {
                <div class="alert alert-success">@_message</div>
            }
            @if (_error is not null)
            {
                <div class="alert alert-danger">@_error</div>
            }

            <PolicyPacksPicker Model="_agentic" />

            <div class="kx-section-save">
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save policies")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string AppId { get; set; } = string.Empty;

    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private ChatClient ChatApi { get; set; } = default!;
    [Inject] private AdminSession Session { get; set; } = default!;

    private bool _loading = true;
    private bool _saving;
    private string? _loadError;
    private string? _message;
    private string? _error;
    private AgenticConfigForm _agentic = new();
    private AgenticConfig? _loadedAgentic;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _message = null;
        _error = null;

        if (!Session.IsConfigured)
        {
            _loadError = "Configure Settings first.";
            _loading = false;
            return;
        }

        try
        {
            var credentials = await Api.GetAppCredentialsAsync(AppId);
            if (credentials is null || string.IsNullOrWhiteSpace(credentials.ApiKey))
            {
                _loadError = "API key unavailable — could not load app config.";
                return;
            }

            var settings = new ChatTestSettings
            {
                AppId = AppId,
                UserId = "admin-policies",
                ApiKey = credentials.ApiKey,
                Model = "qwen3.5:9b"
            };

            var config = await ChatApi.GetAppConfigAsync(settings);
            if (config is null)
            {
                _loadError = "Empty config.";
                return;
            }

            _loadedAgentic = config.Agentic ?? AgenticConfig.Disabled;
            _agentic = AgenticConfigForm.FromConfig(_loadedAgentic);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        try
        {
            var baseAgentic = _loadedAgentic ?? AgenticConfig.Disabled;
            var packsOnly = _agentic.ToConfig().PolicyPacks;
            var patch = new AppConfigPatchRequest
            {
                Agentic = baseAgentic with { PolicyPacks = packsOnly }
            };
            await Api.PatchConfigAsync(AppId, patch);
            _loadedAgentic = patch.Agentic;
            _message = _agentic.PolicyPacksExplicit
                ? "Custom policies saved for this app."
                : "App now inherits platform defaults.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
