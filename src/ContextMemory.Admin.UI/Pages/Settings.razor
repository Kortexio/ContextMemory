@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout

<PageTitle>Settings - ContextMemory Admin</PageTitle>

<div class="alert alert-info">
    <strong>First-time setup.</strong>
    Connect this console to a running ContextMemory API using the Master Key from
    <code>ContextMemory:MasterKey</code>. In Docker Compose these fields are pre-filled for you.
</div>

<div class="card card-outline card-primary mb-3">
    <div class="card-header"><h3 class="card-title">API connection</h3></div>
    <div class="card-body">
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="apiBaseUrl">API base URL</label>
                <InputText id="apiBaseUrl" class="form-control" @bind-Value="_model.ApiBaseUrl" placeholder="http://localhost:5100" />
                <FieldHelp>
                    Base URL of the ContextMemory API as seen from this Admin host.
                    Local: <code>http://localhost:5100</code>. Docker Compose: <code>http://api:8080</code>
                    (server-side calls stay on the Docker network).
                </FieldHelp>
            </div>

            <div class="form-group">
                <label for="masterKey">Master key</label>
                <div class="input-group">
                    <InputText id="masterKey" class="form-control" type="@(_showMasterKey ? "text" : "password")" @bind-Value="_model.MasterKey" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _showMasterKey = !_showMasterKey">
                            <i class="fas @(_showMasterKey ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                </div>
                <FieldHelp>
                    Admin secret (<code>ContextMemory:MasterKey</code>). Required for listing apps, rotating keys, and saving config.
                    Default demo value: <code>cm_master_dev_key_change_me</code>.
                </FieldHelp>
            </div>

            @if (_message is not null)
            {
                <div class="alert alert-success">@_message</div>
            }
            @if (_error is not null)
            {
                <div class="alert alert-danger">@_error</div>
            }

            <button class="btn btn-primary" type="submit" disabled="@_saving">
                @(_saving ? "Working…" : "Save")
            </button>
            <button class="btn btn-outline-secondary ml-2" type="button" @onclick="TestConnectionAsync" disabled="@_saving">
                Test connection
            </button>
            <button class="btn btn-outline-danger ml-2" type="button" @onclick="ClearAsync" disabled="@_saving">
                Reset to defaults
            </button>
        </EditForm>
    </div>
</div>

@if (_health is not null)
{
    <div class="card card-outline card-info">
        <div class="card-header"><h3 class="card-title">Health check</h3></div>
        <div class="card-body">
            <p>Status: <strong class="@(_health.Status.Equals("Healthy", StringComparison.OrdinalIgnoreCase) ? "text-success" : "text-warning")">@_health.Status</strong></p>
            @if (_health.Checks is not null)
            {
                <ul class="mb-0">
                    <li>Ollama: @_health.Checks.Ollama</li>
                    @if (_health.Checks.Database is not null)
                    {
                        <li>Database: @_health.Checks.Database</li>
                    }
                    <li>Persistence: @_health.Checks.Persistence</li>
                    <li>Apps loaded: @_health.Checks.AppsLoaded</li>
                    <li>Default model: @_health.Checks.DefaultModel</li>
                </ul>
            }
        </div>
    </div>
}

@if (_metricsUrl is not null)
{
    <p class="mt-3 small text-muted">
        Prometheus metrics (public): <a href="@_metricsUrl" target="_blank" rel="noopener">@_metricsUrl</a>
    </p>
}

@code {
    [Inject] private AdminSession Session { get; set; } = default!;
    [Inject] private AdminApiClient Api { get; set; } = default!;

    private AdminSettings _model = new();
    private HealthResponseDto? _health;
    private string? _metricsUrl;
    private bool _saving;
    private bool _showMasterKey;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        _model = new AdminSettings
        {
            ApiBaseUrl = Session.Settings.ApiBaseUrl,
            MasterKey = Session.Settings.MasterKey
        };

        if (Session.IsConfigured)
            _metricsUrl = Api.GetMetricsUrl();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        try
        {
            await Session.SaveAsync(_model);
            _metricsUrl = Api.GetMetricsUrl();
            _message = "Settings saved in this browser.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        _health = null;
        try
        {
            await Session.SaveAsync(_model);
            _metricsUrl = Api.GetMetricsUrl();

            var apps = await Api.GetAppsAsync();
            _health = await Api.GetHealthAsync();
            _message = $"Connected: {apps.Count} app(s). Health: {_health?.Status ?? "n/a"}.";
        }
        catch (Exception ex)
        {
            _error = FriendlyConnectionError(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ClearAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        _health = null;
        _metricsUrl = null;
        try
        {
            await Session.ClearAsync();
            _model = new AdminSettings
            {
                ApiBaseUrl = Session.Settings.ApiBaseUrl,
                MasterKey = Session.Settings.MasterKey
            };
            if (Session.IsConfigured)
                _metricsUrl = Api.GetMetricsUrl();
            _message = "Browser settings cleared; host defaults restored.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FriendlyConnectionError(string message)
    {
        if (message.Contains("Connection refused", StringComparison.OrdinalIgnoreCase)
            || message.Contains("No connection could be made", StringComparison.OrdinalIgnoreCase)
            || message.Contains("actively refused", StringComparison.OrdinalIgnoreCase))
        {
            return "Cannot reach the API. Check that ContextMemory.Api is running and the base URL is correct "
                + "(Docker: http://api:8080 from Admin container; local: http://localhost:5100). "
                + "Details: " + message;
        }

        if (message.Contains("401", StringComparison.OrdinalIgnoreCase)
            || message.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase))
        {
            return "Unauthorized — Master Key does not match ContextMemory:MasterKey on the API. " + message;
        }

        return message;
    }
}
