@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout

<PageTitle>Settings - Kortexio Admin</PageTitle>

<div class="kx-page-header">
    <div>
        <h1 class="kx-page-title">Connection</h1>
        <p class="kx-page-lead">Connect this console to a running ContextMemory API with the Master Key.</p>
    </div>
</div>

@if (!Session.IsConfigured)
{
    <div class="kx-empty mb-3">
        <h2>Not connected yet</h2>
        <p>Paste the API base URL and Master Key below, then test the connection.</p>
    </div>
}

<div class="kx-form-narrow">
    <div class="kx-panel">
        <div class="kx-panel-head">
            <h2>API connection</h2>
        </div>
        <div class="kx-panel-body">
            <p class="text-muted small mb-3">
                Use <code>ContextMemory:MasterKey</code>. In Docker Compose these fields are pre-filled for you.
            </p>

            <EditForm Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="apiBaseUrl">API base URL</label>
                    <InputText id="apiBaseUrl" class="form-control" @bind-Value="_model.ApiBaseUrl" placeholder="http://localhost:5100" />
                    <FieldHelp>
                        Base URL of the ContextMemory API as seen from this Admin host.
                        Local: <code>http://localhost:5100</code>. Docker Compose: <code>http://api:8080</code>
                        (server-side calls stay on the Docker network).
                    </FieldHelp>
                </div>

                <div class="form-group">
                    <label for="masterKey">Master key</label>
                    <div class="input-group">
                        <InputText id="masterKey" class="form-control" type="@(_showMasterKey ? "text" : "password")" @bind-Value="_model.MasterKey" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showMasterKey = !_showMasterKey">
                                <i class="fas @(_showMasterKey ? "fa-eye-slash" : "fa-eye")"></i>
                            </button>
                        </div>
                    </div>
                    <FieldHelp>
                        Admin secret (<code>ContextMemory:MasterKey</code>). Required for listing apps, rotating keys, and saving config.
                        Default demo value: <code>cm_master_dev_key_change_me</code>.
                    </FieldHelp>
                </div>

                @if (_message is not null)
                {
                    <div class="alert alert-success">@_message</div>
                }
                @if (_error is not null)
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <div class="d-flex flex-wrap" style="gap:0.5rem">
                    <button class="btn btn-primary" type="submit" disabled="@_saving">
                        @(_saving ? "Working…" : "Save")
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="TestConnectionAsync" disabled="@_saving">
                        Test connection
                    </button>
                    <button class="btn btn-outline-danger" type="button" @onclick="ClearAsync" disabled="@_saving">
                        Reset to defaults
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    @if (_health is not null)
    {
        <div class="kx-panel">
            <div class="kx-panel-head">
                <h2>Health check</h2>
                <span class="@(_health.Status.Equals("Healthy", StringComparison.OrdinalIgnoreCase) ? "kx-status-ok" : "kx-status-warn")">
                    <strong>@_health.Status</strong>
                </span>
            </div>
            <div class="kx-panel-body">
                @if (_health.Checks is not null)
                {
                    <div class="kx-health-grid">
                        <div class="kx-health-item"><small>Ollama</small><strong>@_health.Checks.Ollama</strong></div>
                        @if (_health.Checks.Database is not null)
                        {
                            <div class="kx-health-item"><small>Database</small><strong>@_health.Checks.Database</strong></div>
                        }
                        <div class="kx-health-item"><small>Persistence</small><strong>@_health.Checks.Persistence</strong></div>
                        <div class="kx-health-item"><small>Apps loaded</small><strong>@_health.Checks.AppsLoaded</strong></div>
                        <div class="kx-health-item"><small>Default model</small><strong>@_health.Checks.DefaultModel</strong></div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_metricsUrl is not null)
    {
        <p class="small text-muted">
            Prometheus metrics: <a href="@_metricsUrl" target="_blank" rel="noopener">@_metricsUrl</a>
        </p>
    }

    @if (Session.IsConfigured)
    {
        <div class="kx-panel mt-3">
            <div class="kx-panel-head">
                <h2>Platform defaults</h2>
            </div>
            <div class="kx-panel-body">
                <p class="text-muted small mb-3">
                    Defaults applied across apps when per-app values are empty. Stored in
                    <code>platform-defaults.json</code> under the API data path.
                </p>

                @if (_platformLoading)
                {
                    <div class="kx-loading-banner"><i class="fas fa-spinner fa-spin"></i> Loading platform defaults…</div>
                }
                else
                {
                    <ModelPicker @bind-Value="_platformForm.DefaultWikiLlmModel"
                                 Label="Default wiki maintainer model"
                                 AllowEmpty="true"
                                 EmptyLabel="(empty = each app's chat model)"
                                 InputId="defaultWikiLlmModel">
                        <FieldHelp>
                            Used by session wiki maintainer/compactor when the app does not set
                            <code>WikiLlmModel</code>. Empty falls back to the app chat model.
                        </FieldHelp>
                    </ModelPicker>

                    @if (_platformMessage is not null)
                    {
                        <div class="alert alert-success">@_platformMessage</div>
                    }
                    @if (_platformError is not null)
                    {
                        <div class="alert alert-danger">@_platformError</div>
                    }

                    <div class="d-flex flex-wrap" style="gap:0.5rem">
                        <button class="btn btn-primary" type="button" @onclick="SavePlatformDefaultsAsync" disabled="@_platformSaving">
                            @(_platformSaving ? "Saving…" : "Save platform defaults")
                        </button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="LoadPlatformDefaultsAsync" disabled="@_platformSaving">
                            Reload
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] private AdminSession Session { get; set; } = default!;
    [Inject] private AdminApiClient Api { get; set; } = default!;

    private AdminSettings _model = new();
    private HealthResponseDto? _health;
    private string? _metricsUrl;
    private bool _saving;
    private bool _showMasterKey;
    private string? _message;
    private string? _error;

    private readonly PlatformDefaultsForm _platformForm = new();
    private bool _platformLoading;
    private bool _platformSaving;
    private string? _platformMessage;
    private string? _platformError;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        _model = new AdminSettings
        {
            ApiBaseUrl = Session.Settings.ApiBaseUrl,
            MasterKey = Session.Settings.MasterKey
        };

        if (Session.IsConfigured)
        {
            _metricsUrl = Api.GetMetricsUrl();
            await LoadPlatformDefaultsAsync();
        }
    }

    private async Task LoadPlatformDefaultsAsync()
    {
        if (!Session.IsConfigured)
            return;

        _platformLoading = true;
        _platformMessage = null;
        _platformError = null;
        try
        {
            var defaults = await Api.GetPlatformDefaultsAsync();
            _platformForm.DefaultWikiLlmModel = defaults?.DefaultWikiLlmModel ?? string.Empty;
        }
        catch (Exception ex)
        {
            _platformError = FriendlyConnectionError(ex.Message);
        }
        finally
        {
            _platformLoading = false;
        }
    }

    private async Task SavePlatformDefaultsAsync()
    {
        _platformSaving = true;
        _platformMessage = null;
        _platformError = null;
        try
        {
            var updated = await Api.PatchPlatformDefaultsAsync(new PlatformDefaultsPatchRequest
            {
                DefaultWikiLlmModel = _platformForm.DefaultWikiLlmModel?.Trim() ?? string.Empty
            });
            _platformForm.DefaultWikiLlmModel = updated?.DefaultWikiLlmModel ?? string.Empty;
            _platformMessage = "Platform defaults saved.";
        }
        catch (Exception ex)
        {
            _platformError = FriendlyConnectionError(ex.Message);
        }
        finally
        {
            _platformSaving = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        try
        {
            await Session.SaveAsync(_model);
            _metricsUrl = Api.GetMetricsUrl();
            _message = "Settings saved in this browser.";
            if (Session.IsConfigured)
                await LoadPlatformDefaultsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        _health = null;
        try
        {
            await Session.SaveAsync(_model);
            _metricsUrl = Api.GetMetricsUrl();

            var apps = await Api.GetAppsAsync();
            _health = await Api.GetHealthAsync();
            _message = $"Connected: {apps.Count} app(s). Health: {_health?.Status ?? "n/a"}.";
            await LoadPlatformDefaultsAsync();
        }
        catch (Exception ex)
        {
            _error = FriendlyConnectionError(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ClearAsync()
    {
        _saving = true;
        _message = null;
        _error = null;
        _health = null;
        _metricsUrl = null;
        try
        {
            await Session.ClearAsync();
            _model = new AdminSettings
            {
                ApiBaseUrl = Session.Settings.ApiBaseUrl,
                MasterKey = Session.Settings.MasterKey
            };
            if (Session.IsConfigured)
                _metricsUrl = Api.GetMetricsUrl();
            _message = "Browser settings cleared; host defaults restored.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FriendlyConnectionError(string message)
    {
        if (message.Contains("Connection refused", StringComparison.OrdinalIgnoreCase)
            || message.Contains("No connection could be made", StringComparison.OrdinalIgnoreCase)
            || message.Contains("actively refused", StringComparison.OrdinalIgnoreCase))
        {
            return "Cannot reach the API. Check that ContextMemory.Api is running and the base URL is correct "
                + "(Docker: http://api:8080 from Admin container; local: http://localhost:5100). "
                + "Details: " + message;
        }

        if (message.Contains("401", StringComparison.OrdinalIgnoreCase)
            || message.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase))
        {
            return "Unauthorized — Master Key does not match ContextMemory:MasterKey on the API. " + message;
        }

        return message;
    }

    private sealed class PlatformDefaultsForm
    {
        public string DefaultWikiLlmModel { get; set; } = string.Empty;
    }
}

