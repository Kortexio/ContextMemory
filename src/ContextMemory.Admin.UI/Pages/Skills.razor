@page "/skills"
@inject AdminApiClient Api
@inject AdminSession Session
@inject IJSRuntime Js
@using ContextMemory.Admin.UI.Models
@using ContextMemory.Admin.UI.Services
@layout MainLayout

<PageTitle>Skills &amp; Guardrails - Kortexio Admin</PageTitle>

<div class="kx-page-header">
    <div>
        <h1 class="kx-page-title">Skills &amp; Guardrails</h1>
        <p class="kx-page-lead">
            Platform defaults shared by all apps. Per-app overrides live on each tenant’s
            <strong>Policies</strong> page (or Config → Agentic).
        </p>
    </div>
    <div class="d-flex flex-wrap" style="gap:0.5rem">
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_busy">
            <i class="fas fa-sync"></i> Refresh
        </button>
        <button class="btn btn-primary" @onclick="StartCreate" disabled="@_busy">
            <i class="fas fa-plus"></i> New skill
        </button>
    </div>
</div>

@if (!Session.IsConfigured)
{
    <div class="kx-empty">
        <h2>Not connected</h2>
        <p>Configure the API URL and Master Key to manage the platform catalog.</p>
        <NavLink class="btn btn-primary" href="/settings">Connect</NavLink>
    </div>
}
else
{
    <div class="kx-metrics" style="margin-bottom:1rem">
        <div class="kx-metric">
            <div class="kx-metric-label">Skills</div>
            <div class="kx-metric-value">@_skills.Count</div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Default-on skills</div>
            <div class="kx-metric-value">@_skills.Count(s => s.IsDefaultEnabled)</div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Guardrails</div>
            <div class="kx-metric-value">@_guardrails.Count</div>
        </div>
        <div class="kx-metric">
            <div class="kx-metric-label">Default-on guardrails</div>
            <div class="kx-metric-value">@_guardrails.Count(g => g.IsDefaultEnabled)</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success">@_info</div>
    }

    <div class="kx-panel">
        <div class="kx-panel-head"><h2>Import skill</h2></div>
        <div class="kx-panel-body">
            <InputFile OnChange="OnImportFileAsync" accept=".json,.md,.skill.json" />
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="replaceImport" @bind="_replaceOnImport" />
                <label class="form-check-label" for="replaceImport">Replace if id already exists</label>
            </div>
        </div>
    </div>

    @if (_editing is not null)
    {
        <div class="kx-panel">
            <div class="kx-panel-head">
                <h2>@(_isCreate ? "Create skill" : $"Edit {_editing.Id}")</h2>
                @if (_editing.IsSystem)
                {
                    <span class="kx-badge">system (prompt editable)</span>
                }
            </div>
            <div class="kx-panel-body">
                <div class="form-row">
                    <div class="col-md-4 form-group">
                        <label>Id (slug)</label>
                        <InputText class="form-control" @bind-Value="_editing.Id" disabled="@(!_isCreate)" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="_editing.Name" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Category</label>
                        <InputText class="form-control" @bind-Value="_editing.Category" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <InputText class="form-control" @bind-Value="_editing.Description" />
                </div>
                <div class="form-group">
                    <label>Prompt markdown</label>
                    <InputTextArea class="form-control" rows="12" @bind-Value="_editing.PromptMarkdown" />
                </div>
                <div class="form-row">
                    <div class="col-md-4 form-group">
                        <label>Sort order</label>
                        <InputNumber class="form-control" @bind-Value="_editing.SortOrder" />
                    </div>
                    <div class="col-md-4 form-group d-flex align-items-end">
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="_editing.IsDefaultEnabled" />
                            <label class="form-check-label">Default enabled for apps that inherit</label>
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_busy">Save</button>
                <button class="btn btn-link btn-sm" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    }

    <div class="kx-section-head">
        <h2>Platform skill defaults</h2>
        <p>Content injected into the agentic system prompt. Mark default-on for apps that inherit.</p>
    </div>

    <div class="kx-panel">
        <div class="kx-panel-head"><h2>Skills</h2></div>
        @if (_skills.Count == 0 && !_busy)
        {
            <div class="kx-panel-body">
                <div class="kx-empty" style="border:0;max-width:none">
                    <h2>No skills yet</h2>
                    <p>Create a custom skill or import a <code>.skill.json</code> file.</p>
                    <button class="btn btn-primary" @onclick="StartCreate">New skill</button>
                </div>
            </div>
        }
        else
        {
            <div class="kx-table-wrap">
                <table class="kx-table">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Default</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var skill in _skills)
                    {
                        <tr>
                            <td><code>@skill.Id</code></td>
                            <td>
                                @skill.Name
                                @if (skill.IsSystem)
                                {
                                    <span class="kx-badge ml-1">system</span>
                                }
                            </td>
                            <td>@skill.Category</td>
                            <td>@(skill.IsDefaultEnabled ? "yes" : "no")</td>
                            <td>
                                <div class="kx-actions">
                                    <button class="btn btn-xs btn-outline-primary" @onclick="() => StartEdit(skill)">Edit</button>
                                    <button class="btn btn-xs btn-outline-secondary" @onclick="() => ExportAsync(skill)">Download</button>
                                    @if (!skill.IsSystem)
                                    {
                                        <button class="btn btn-xs btn-outline-danger" @onclick="() => DeleteAsync(skill)">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="kx-section-head">
        <h2>Platform guardrail defaults</h2>
        <p>Runtime checks applied when an app inherits or enables the pack. Toggle per app under Policies.</p>
    </div>

    <div class="kx-panel">
        <div class="kx-panel-head">
            <h2>Guardrail packs</h2>
        </div>
        @if (_guardrails.Count == 0 && !_busy)
        {
            <div class="kx-panel-body">
                <p class="text-muted mb-0">No guardrails in catalog. Restart API to re-seed if the database was empty.</p>
            </div>
        }
        else
        {
            <div class="kx-table-wrap">
                <table class="kx-table">
                    <thead>
                    <tr><th>Id</th><th>Name</th><th>Kind</th><th>Default</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var g in _guardrails)
                    {
                        <tr>
                            <td><code>@g.Id</code></td>
                            <td>@g.Name</td>
                            <td><code>@g.Kind</code></td>
                            <td>@(g.IsDefaultEnabled ? "yes" : "no")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="kx-panel-foot">
            <span class="text-muted">Per-app selection:</span>
            open an app → <strong>Skills &amp; guardrails</strong> in the app menu
        </div>
    </div>
}

@code {
    private List<AgenticSkillAdminDto> _skills = [];
    private List<AgenticGuardrailAdminDto> _guardrails = [];
    private AgenticSkillAdminDto? _editing;
    private bool _isCreate;
    private bool _busy;
    private bool _replaceOnImport;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (!Session.IsConfigured)
        {
            _error = null;
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var catalog = await Api.GetAgenticCatalogAsync();
            _skills = catalog?.Skills?.OrderBy(s => s.SortOrder).ThenBy(s => s.Name).ToList() ?? [];
            _guardrails = catalog?.Guardrails?.OrderBy(g => g.SortOrder).ThenBy(g => g.Name).ToList() ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartCreate()
    {
        _isCreate = true;
        _editing = new AgenticSkillAdminDto
        {
            Category = "general",
            SortOrder = 500,
            IsDefaultEnabled = false,
            PromptMarkdown = "## My skill\n- Rule one\n- Reply in the user's language.\n"
        };
        _info = null;
    }

    private void StartEdit(AgenticSkillAdminDto skill)
    {
        _isCreate = false;
        _editing = new AgenticSkillAdminDto
        {
            Id = skill.Id,
            Name = skill.Name,
            Description = skill.Description,
            PromptMarkdown = skill.PromptMarkdown,
            Category = skill.Category,
            IsSystem = skill.IsSystem,
            IsDefaultEnabled = skill.IsDefaultEnabled,
            SortOrder = skill.SortOrder,
            LinkedGuardrailIds = skill.LinkedGuardrailIds.ToList()
        };
        _info = null;
    }

    private void CancelEdit() => _editing = null;

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _busy = true;
        _error = null;
        try
        {
            await Api.UpsertAgenticSkillAsync(_editing, _isCreate);
            _info = $"Saved '{_editing.Id}'.";
            _editing = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(AgenticSkillAdminDto skill)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.DeleteAgenticSkillAsync(skill.Id);
            _info = $"Deleted '{skill.Id}'.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync(AgenticSkillAdminDto skill)
    {
        try
        {
            var url = Api.GetSkillExportUrl(skill.Id);
            using var http = new HttpClient();
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Session.Settings.MasterKey);
            using var res = await http.SendAsync(req);
            res.EnsureSuccessStatusCode();
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var b64 = Convert.ToBase64String(bytes);
            await Js.InvokeVoidAsync(
                "eval",
                $@"(function(){{var a=document.createElement('a');a.href='data:application/json;base64,{b64}';a.download='{skill.Id}.skill.json';a.click();}})()");
            _info = $"Downloaded {skill.Id}.skill.json";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnImportFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _busy = true;
        _error = null;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 2_000_000);
            var imported = await Api.ImportAgenticSkillAsync(stream, file.Name, _replaceOnImport);
            _info = $"Imported '{imported.Id}'.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
