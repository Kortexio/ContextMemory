@page "/skills"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminApiClient Api
@inject AdminSession Session
@inject IJSRuntime Js
@using ContextMemory.Admin.UI.Components
@using ContextMemory.Admin.UI.Models
@using ContextMemory.Admin.UI.Services
@layout MainLayout

<PageTitle>Platform Skills &amp; Guardrails - Kortexio Admin</PageTitle>

<div class="kx-page-header">
    <div>
        <h1 class="kx-page-title">Platform Skills &amp; Guardrails</h1>
        <p class="kx-page-lead">
            Generic defaults for <strong>all apps</strong>.
            <strong>Default-on</strong> = included in every app;
            <strong>Activation</strong> = how it is applied (<code>skill</code>, <code>always_on</code>, <code>requestable</code>).
            App-specific packs are under each app’s <strong>Skills &amp; guardrails</strong>.
        </p>
    </div>
    <div class="d-flex flex-wrap" style="gap:0.5rem">
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_busy"><i class="fas fa-sync"></i> Refresh</button>
        <button class="btn btn-outline-primary" @onclick="StartCreateGuardrail" disabled="@_busy"><i class="fas fa-plus"></i> New guardrail</button>
        <button class="btn btn-primary" @onclick="StartCreateSkill" disabled="@_busy"><i class="fas fa-plus"></i> New skill</button>
    </div>
</div>

@if (!Session.IsConfigured)
{
    <div class="kx-empty">
        <h2>Not connected</h2>
        <p>Configure the API URL and Master Key to manage the platform catalog.</p>
        <NavLink class="btn btn-primary" href="/settings">Connect</NavLink>
    </div>
}
else
{
    <div class="kx-metrics" style="margin-bottom:1rem">
        <div class="kx-metric"><div class="kx-metric-label">Skills</div><div class="kx-metric-value">@_skills.Count</div></div>
        <div class="kx-metric"><div class="kx-metric-label">Default-on skills</div><div class="kx-metric-value">@_skills.Count(s => s.IsDefaultEnabled)</div></div>
        <div class="kx-metric"><div class="kx-metric-label">Guardrails</div><div class="kx-metric-value">@_guardrails.Count</div></div>
        <div class="kx-metric"><div class="kx-metric-label">Default-on guardrails</div><div class="kx-metric-value">@_guardrails.Count(g => g.IsDefaultEnabled)</div></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }
    @if (!string.IsNullOrWhiteSpace(_info)) { <div class="alert alert-success">@_info</div> }

    @if (_editingSkill is not null)
    {
        <div class="kx-panel">
            <div class="kx-panel-head">
                <h2>@(_isCreateSkill ? "Create skill" : $"Edit {_editingSkill.Id}")</h2>
                @if (_editingSkill.IsSystem) { <span class="kx-badge">system</span> }
            </div>
            <div class="kx-panel-body">
                <div class="form-row">
                    <div class="col-md-4 form-group">
                        <label>Id (slug)</label>
                        <InputText class="form-control" @bind-Value="_editingSkill.Id" disabled="@(!_isCreateSkill)" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="_editingSkill.Name" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Category</label>
                        <InputText class="form-control" @bind-Value="_editingSkill.Category" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <InputText class="form-control" @bind-Value="_editingSkill.Description" />
                </div>
                <div class="form-group">
                    <label>Prompt markdown</label>
                    <MarkdownEditor @bind-Value="_editingSkill.PromptMarkdown" Rows="14" />
                </div>
                <div class="form-row">
                    <div class="col-md-4 form-group">
                        <label>Activation</label>
                        <InputSelect class="form-control" @bind-Value="_editingSkill.Activation">
                            <option value="skill">skill — discover / skill_read</option>
                            <option value="always_on">always_on — inline every turn</option>
                            <option value="requestable">requestable — rule_search / rule_read</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Sort order</label>
                        <InputNumber class="form-control" @bind-Value="_editingSkill.SortOrder" />
                    </div>
                    <div class="col-md-4 form-group d-flex align-items-end">
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="_editingSkill.IsDefaultEnabled" />
                            <label class="form-check-label">Default enabled for all apps</label>
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveSkillAsync" disabled="@_busy">Save</button>
                <button class="btn btn-link btn-sm" @onclick="() => _editingSkill = null">Cancel</button>
            </div>
        </div>
    }

    @if (_editingGuardrail is not null)
    {
        <div class="kx-panel">
            <div class="kx-panel-head">
                <h2>@(_isCreateGuardrail ? "Create guardrail" : $"Edit {_editingGuardrail.Id}")</h2>
                @if (_editingGuardrail.IsSystem) { <span class="kx-badge">system</span> }
            </div>
            <div class="kx-panel-body">
                <div class="form-row">
                    <div class="col-md-3 form-group">
                        <label>Id (slug)</label>
                        <InputText class="form-control" @bind-Value="_editingGuardrail.Id" disabled="@(!_isCreateGuardrail)" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="_editingGuardrail.Name" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Kind</label>
                        <InputText class="form-control" @bind-Value="_editingGuardrail.Kind" placeholder="url-fetch" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Sort order</label>
                        <InputNumber class="form-control" @bind-Value="_editingGuardrail.SortOrder" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <InputText class="form-control" @bind-Value="_editingGuardrail.Description" />
                </div>
                <div class="form-group">
                    <label>Config JSON</label>
                    <InputTextArea class="form-control" rows="6" @bind-Value="_editingGuardrail.ConfigJson" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="_editingGuardrail.IsDefaultEnabled" />
                    <label class="form-check-label">Default enabled for all apps</label>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SaveGuardrailAsync" disabled="@_busy">Save</button>
                <button class="btn btn-link btn-sm" @onclick="() => _editingGuardrail = null">Cancel</button>
            </div>
        </div>
    }

    <div class="kx-panel">
        <div class="kx-panel-head"><h2>Import skill</h2></div>
        <div class="kx-panel-body">
            <InputFile OnChange="OnImportSkillAsync" accept=".json,.md,.skill.json" />
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="replaceSkillImport" @bind="_replaceOnImport" />
                <label class="form-check-label" for="replaceSkillImport">Replace if id already exists</label>
            </div>
        </div>
    </div>

    <div class="kx-section-head">
        <h2>Platform skills</h2>
        <p>Markdown injected into the agentic system prompt when default-on.</p>
    </div>
    <div class="kx-panel">
        <div class="kx-table-wrap">
            <table class="kx-table">
                <thead><tr><th>Id</th><th>Name</th><th>Category</th><th>Activation</th><th>Default</th><th></th></tr></thead>
                <tbody>
                @foreach (var skill in _skills)
                {
                    <tr>
                        <td><code>@skill.Id</code></td>
                        <td>@skill.Name @if (skill.IsSystem) { <span class="kx-badge ml-1">system</span> }</td>
                        <td>@skill.Category</td>
                        <td><code>@(string.IsNullOrWhiteSpace(skill.Activation) ? "skill" : skill.Activation)</code></td>
                        <td>@(skill.IsDefaultEnabled ? "yes" : "no")</td>
                        <td class="kx-actions">
                            <button class="btn btn-xs btn-outline-primary" @onclick="() => StartEditSkill(skill)">Edit</button>
                            <button class="btn btn-xs btn-outline-secondary" @onclick="() => ExportSkillAsync(skill)">Download</button>
                            @if (!skill.IsSystem)
                            {
                                <button class="btn btn-xs btn-outline-danger" @onclick="() => DeleteSkillAsync(skill)">Delete</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="kx-section-head">
        <h2>Platform guardrails</h2>
        <p>Runtime validators applied when default-on. App-owned guardrails are additive.</p>
    </div>
    <div class="kx-panel">
        <div class="kx-panel-body mb-2">
            <InputFile OnChange="OnImportGuardrailAsync" accept=".json,.guardrail.json" />
            <span class="text-muted small ml-2">Import guardrail JSON</span>
        </div>
        <div class="kx-table-wrap">
            <table class="kx-table">
                <thead><tr><th>Id</th><th>Name</th><th>Kind</th><th>Default</th><th></th></tr></thead>
                <tbody>
                @foreach (var g in _guardrails)
                {
                    <tr>
                        <td><code>@g.Id</code></td>
                        <td>@g.Name @if (g.IsSystem) { <span class="kx-badge ml-1">system</span> }</td>
                        <td><code>@g.Kind</code></td>
                        <td>@(g.IsDefaultEnabled ? "yes" : "no")</td>
                        <td class="kx-actions">
                            <button class="btn btn-xs btn-outline-primary" @onclick="() => StartEditGuardrail(g)">Edit</button>
                            <button class="btn btn-xs btn-outline-secondary" @onclick="() => ExportGuardrailAsync(g)">Download</button>
                            @if (!g.IsSystem)
                            {
                                <button class="btn btn-xs btn-outline-danger" @onclick="() => DeleteGuardrailAsync(g)">Delete</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<AgenticSkillAdminDto> _skills = [];
    private List<AgenticGuardrailAdminDto> _guardrails = [];
    private AgenticSkillAdminDto? _editingSkill;
    private AgenticGuardrailAdminDto? _editingGuardrail;
    private bool _isCreateSkill;
    private bool _isCreateGuardrail;
    private bool _busy;
    private bool _replaceOnImport;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (!Session.IsConfigured) return;
        _busy = true; _error = null;
        try
        {
            var catalog = await Api.GetAgenticCatalogAsync();
            _skills = catalog?.Skills?.OrderBy(s => s.SortOrder).ThenBy(s => s.Name).ToList() ?? [];
            _guardrails = catalog?.Guardrails?.OrderBy(g => g.SortOrder).ThenBy(g => g.Name).ToList() ?? [];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void StartCreateSkill()
    {
        _isCreateSkill = true;
        _editingGuardrail = null;
        _editingSkill = new AgenticSkillAdminDto
        {
            Category = "general", Activation = "skill", SortOrder = 500, IsDefaultEnabled = false,
            PromptMarkdown = "## My skill\n- Rule one\n"
        };
    }

    private void StartEditSkill(AgenticSkillAdminDto skill)
    {
        _isCreateSkill = false;
        _editingGuardrail = null;
        _editingSkill = new AgenticSkillAdminDto
        {
            Id = skill.Id, Name = skill.Name, Description = skill.Description,
            PromptMarkdown = skill.PromptMarkdown, Category = skill.Category,
            Activation = string.IsNullOrWhiteSpace(skill.Activation) ? "skill" : skill.Activation,
            IsSystem = skill.IsSystem, IsDefaultEnabled = skill.IsDefaultEnabled,
            SortOrder = skill.SortOrder, LinkedGuardrailIds = skill.LinkedGuardrailIds.ToList()
        };
    }

    private void StartCreateGuardrail()
    {
        _isCreateGuardrail = true;
        _editingSkill = null;
        _editingGuardrail = new AgenticGuardrailAdminDto
        {
            Kind = "blocked-patterns", SortOrder = 500, IsDefaultEnabled = false,
            ConfigJson = "{\n  \"patterns\": []\n}"
        };
    }

    private void StartEditGuardrail(AgenticGuardrailAdminDto g)
    {
        _isCreateGuardrail = false;
        _editingSkill = null;
        _editingGuardrail = new AgenticGuardrailAdminDto
        {
            Id = g.Id, Name = g.Name, Description = g.Description, Kind = g.Kind,
            ConfigJson = g.ConfigJson, IsSystem = g.IsSystem,
            IsDefaultEnabled = g.IsDefaultEnabled, SortOrder = g.SortOrder
        };
    }

    private async Task SaveSkillAsync()
    {
        if (_editingSkill is null) return;
        _busy = true; _error = null;
        try
        {
            await Api.UpsertAgenticSkillAsync(_editingSkill, _isCreateSkill);
            _info = $"Saved skill '{_editingSkill.Id}'.";
            _editingSkill = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveGuardrailAsync()
    {
        if (_editingGuardrail is null) return;
        _busy = true; _error = null;
        try
        {
            await Api.UpsertAgenticGuardrailAsync(_editingGuardrail, _isCreateGuardrail);
            _info = $"Saved guardrail '{_editingGuardrail.Id}'.";
            _editingGuardrail = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteSkillAsync(AgenticSkillAdminDto skill)
    {
        _busy = true; _error = null;
        try
        {
            await Api.DeleteAgenticSkillAsync(skill.Id);
            _info = $"Deleted '{skill.Id}'.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteGuardrailAsync(AgenticGuardrailAdminDto g)
    {
        _busy = true; _error = null;
        try
        {
            await Api.DeleteAgenticGuardrailAsync(g.Id);
            _info = $"Deleted '{g.Id}'.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ExportSkillAsync(AgenticSkillAdminDto skill) =>
        await DownloadAsync(Api.GetSkillExportUrl(skill.Id), $"{skill.Id}.skill.json");

    private async Task ExportGuardrailAsync(AgenticGuardrailAdminDto g) =>
        await DownloadAsync(Api.GetGuardrailExportUrl(g.Id), $"{g.Id}.guardrail.json");

    private async Task DownloadAsync(string url, string fileName)
    {
        try
        {
            using var http = new HttpClient();
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Session.Settings.MasterKey);
            using var res = await http.SendAsync(req);
            res.EnsureSuccessStatusCode();
            var b64 = Convert.ToBase64String(await res.Content.ReadAsByteArrayAsync());
            await Js.InvokeVoidAsync("eval",
                $@"(function(){{var a=document.createElement('a');a.href='data:application/json;base64,{b64}';a.download='{fileName}';a.click();}})()");
            _info = $"Downloaded {fileName}";
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnImportSkillAsync(InputFileChangeEventArgs e)
    {
        var file = e.File; if (file is null) return;
        _busy = true; _error = null;
        try
        {
            await using var stream = file.OpenReadStream(2_000_000);
            var imported = await Api.ImportAgenticSkillAsync(stream, file.Name, _replaceOnImport);
            _info = $"Imported skill '{imported.Id}'.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnImportGuardrailAsync(InputFileChangeEventArgs e)
    {
        var file = e.File; if (file is null) return;
        _busy = true; _error = null;
        try
        {
            await using var stream = file.OpenReadStream(2_000_000);
            var imported = await Api.ImportAgenticGuardrailAsync(stream, file.Name, _replaceOnImport);
            _info = $"Imported guardrail '{imported.Id}'.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
