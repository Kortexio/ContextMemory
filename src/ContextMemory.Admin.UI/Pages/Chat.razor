@page "/apps/{AppId}/playground"
@page "/chat"
@page "/chat-test"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout
@implements IDisposable

<PageTitle>Playground · @AppId - Kortexio Admin</PageTitle>

<div class="kx-page-header">
    <div>
        <h1 class="kx-page-title">Playground</h1>
        <p class="kx-page-lead">Exercise session memory and the agentic loop for <code>@AppId</code>.</p>
    </div>
</div>

@if (!_adminSession.IsConfigured)
{
    <div class="kx-empty mb-3">
        <h2>Not connected</h2>
        <p>Set the API URL and Master Key before sending messages.</p>
        <NavLink class="btn btn-primary" href="/settings">Connect</NavLink>
    </div>
}

<div class="kx-chat-layout @(_settings.ShowRawJson || HasLabPanels ? "with-inspector" : "")">
    <aside class="kx-chat-side">
        <div class="kx-panel">
            <div class="kx-panel-head"><h3>Session</h3></div>
            <div class="kx-panel-body">
                <div class="form-group">
                    <label>User ID</label>
                    <InputText class="form-control form-control-sm" @bind-Value="_settings.UserId" />
                    <FieldHelp>Sent as <code>X-User-Id</code>.</FieldHelp>
                </div>
                <div class="form-group">
                    <label>Session ID</label>
                    <InputText class="form-control form-control-sm" @bind-Value="_settings.SessionId" placeholder="empty = API generates" />
                    <FieldHelp>Same id keeps the same session wiki.</FieldHelp>
                </div>
                <ModelPicker @bind-Value="_settings.Model"
                             Label="Model"
                             AppId="@AppId"
                             AllowEmpty="true"
                             EmptyLabel="(app default)"
                             InputId="playgroundModel">
                    <FieldHelp>Should match the app config / pulled model tag.</FieldHelp>
                </ModelPicker>

                @if (_appDetail is not null)
                {
                    <div class="kx-chat-app-meta">
                        <div><span>Backend</span> @_appDetail.LlmBackend / @_appDetail.LlmModel</div>
                        <div><span>Memory</span> session wiki · @_appDetail.MaxHistoryMessages msgs</div>
                    </div>
                }

                <div class="d-flex flex-column" style="gap:0.35rem;margin-top:0.75rem">
                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="NewSessionAsync" disabled="@_busy">New session</button>
                    <button class="btn btn-link btn-sm px-0 text-left" type="button" @onclick="ToggleAdvanced">
                        @(_showAdvanced ? "Hide advanced" : "Show advanced")
                    </button>
                </div>

                @if (_showAdvanced)
                {
                    <div class="kx-chat-advanced">
                        <div class="form-group">
                            <label>App ID</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_settings.AppId" disabled="@_boundToApp" />
                        </div>
                        <div class="form-group">
                            <label>App API key</label>
                            <InputText class="form-control form-control-sm" type="password" @bind-Value="_settings.ApiKey" disabled="@_boundToApp" />
                            <FieldHelp>Loaded from credentials@(_boundToApp ? ", read-only" : "").</FieldHelp>
                        </div>

                        <div class="kx-segment">
                            <button type="button" class="@ModeBtnClass(ChatEndpointMode.Chat)" @onclick="() => SetMode(ChatEndpointMode.Chat)">Chat</button>
                            <button type="button" class="@ModeBtnClass(ChatEndpointMode.Generate)" @onclick="() => SetMode(ChatEndpointMode.Generate)">Generate</button>
                        </div>

                        <label class="kx-switch">
                            <InputCheckbox id="streamSwitch" @bind-Value="_settings.Stream" disabled="@_busy" />
                            Streaming (NDJSON)
                        </label>
                        <label class="kx-switch">
                            <InputCheckbox id="rawSwitch" @bind-Value="_settings.ShowRawJson" />
                            Show raw JSON panel
                        </label>

                        <div class="d-flex flex-column" style="gap:0.35rem;margin:0.5rem 0 0.75rem">
                            <button class="btn btn-outline-primary btn-sm" type="button" @onclick="SaveSettingsAsync" disabled="@_busy">Save locally</button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="LoadAppAsync" disabled="@_busy">Reload app</button>
                        </div>

                        <h4 class="kx-chat-advanced-title">Sampling</h4>
                        <div class="form-group">
                            <label>System prompt</label>
                            <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_settings.SystemPrompt" />
                        </div>
                        <div class="form-row">
                            <div class="col-6 form-group">
                                <label>temperature</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_settings.Temperature" />
                            </div>
                            <div class="col-6 form-group">
                                <label>top_p</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_settings.TopP" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="col-6 form-group">
                                <label>top_k</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_settings.TopK" />
                            </div>
                            <div class="col-6 form-group">
                                <label>num_ctx</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_settings.NumCtx" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="col-6 form-group">
                                <label>repeat_penalty</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_settings.RepeatPenalty" />
                            </div>
                            <div class="col-6 form-group">
                                <label>num_predict</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_settings.NumPredict" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>keep_alive</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_settings.KeepAlive" />
                        </div>
                        <div class="form-group mb-0">
                            <label>format (e.g. json)</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_settings.Format" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </aside>

    <section class="kx-chat-main">
        <div class="kx-panel kx-chat-panel">
            <div class="kx-panel-head">
                <div>
                    <h3>@(_settings.Mode == ChatEndpointMode.Chat ? "Chat" : "Generate")</h3>
                    <p class="kx-chat-endpoint-hint">@(_settings.Mode == ChatEndpointMode.Chat ? "POST /v1/chat/completions · legacy /api/chat" : "POST /api/generate")</p>
                </div>
                <div class="kx-actions">
                    @if (_busy)
                    {
                        <button class="btn btn-sm btn-warning" type="button" @onclick="CancelRequest">Stop</button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="RegenerateAsync" disabled="@(_busy || !CanRegenerate)">Regenerate</button>
                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="ClearUi" disabled="@(_busy && _messages.Count == 0)">Clear</button>
                </div>
            </div>

            @if (_settings.Mode == ChatEndpointMode.Chat)
            {
                <div class="chat-messages" @ref="_messagesContainer">
                    @if (_messages.Count == 0)
                    {
                        <div class="kx-empty kx-chat-empty">
                            <h2>Start a conversation</h2>
                            <p>Session memory (history + wiki) is applied automatically. Send only the new message.</p>
                        </div>
                    }
                    @foreach (var msg in _messages)
                    {
                        <div class="chat-row @(msg.Role == "user" ? "chat-row-user" : "chat-row-assistant")">
                            <div class="chat-meta">
                                <span class="badge badge-@(msg.Role == "user" ? "primary" : msg.IsError ? "danger" : "secondary")">@msg.Role</span>
                                @msg.Timestamp.LocalDateTime.ToString("HH:mm:ss")
                                @if (msg.ElapsedMs is not null) { <span> · @msg.ElapsedMs ms</span> }
                                @if (msg.IsStreaming) { <span> · streaming…</span> }
                                @if (!string.IsNullOrEmpty(msg.MessageId)) { <span> · @msg.MessageId</span> }
                            </div>
                            <div class="chat-bubble @(msg.IsError ? "chat-bubble-error" : "")">
                                @if (msg.HasAgenticProgress)
                                {
                                    <div class="agentic-timeline">
                                        <div class="agentic-timeline-title">Agentic</div>
                                        @foreach (var step in msg.AgenticSteps)
                                        {
                                            <div class="agentic-step agentic-step-@step.Status">
                                                <span class="agentic-step-icon">@StepIcon(step.Status)</span>
                                                <div class="agentic-step-body">
                                                    <span class="agentic-step-label">@step.Label</span>
                                                    <div class="agentic-step-meta small text-muted">
                                                        @if (!string.IsNullOrEmpty(step.Phase))
                                                        {
                                                            <span>@FormatPhase(step.Phase)</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(step.ToolName))
                                                        {
                                                            <span> · <code>@step.ToolName</code></span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(step.ArtifactId))
                                                        {
                                                            <span> · artifact <code>@step.ArtifactId</code></span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (msg.AwaitingConfirmation)
                                {
                                    <div class="agentic-confirmation-hint">
                                        <strong>Human confirmation required</strong>
                                        <p class="mb-1">Destructive tool execution is paused until explicit authorization.</p>
                                        @if (!string.IsNullOrEmpty(msg.PendingConfirmationId))
                                        {
                                            <p class="mb-1">
                                                Reply with <code>confirm</code> or send
                                                <code>[CONFIRM:@msg.PendingConfirmationId]</code>
                                            </p>
                                            <button class="btn btn-xs btn-outline-warning" type="button"
                                                    @onclick="() => CopyConfirmTokenAsync(msg.PendingConfirmationId!)">
                                                Copy token
                                            </button>
                                        }
                                        else
                                        {
                                            <p class="mb-0">Reply with <code>confirm</code> to authorize or <code>cancel</code> to abort. (HITL keywords follow tenant locale.)</p>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(msg.FinalContent))
                                {
                                    @if (msg.HasAgenticProgress || msg.AwaitingConfirmation)
                                    {
                                        <div class="agentic-answer-title">Answer</div>
                                    }
                                    <div class="agentic-answer">@msg.FinalContent</div>
                                }
                                else if (!msg.HasAgenticProgress)
                                {
                                    @msg.Content
                                }
                            </div>
                            @if (msg.Role == "assistant" && !string.IsNullOrEmpty(msg.MessageId) && !msg.IsStreaming)
                            {
                                <div class="mt-1">
                                    <button class="btn btn-xs btn-outline-secondary" type="button" @onclick="() => CopyAsync(msg.Content)">Copy</button>
                                </div>
                            }
                            @if (msg.PromptEvalCount is not null || msg.EvalCount is not null)
                            {
                                <div class="small text-muted">tokens in/out: @msg.PromptEvalCount / @msg.EvalCount</div>
                            }
                        </div>
                    }
                </div>
                <div class="kx-panel-foot">
                    <EditForm Model="_chatInput" OnValidSubmit="SendChatAsync">
                        <div class="kx-chat-composer">
                            <InputTextArea class="form-control" rows="2" @bind-Value="_chatInput.Text" placeholder="Message…" disabled="@_busy" />
                            <button class="btn btn-primary" type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_chatInput.Text))">Send</button>
                        </div>
                    </EditForm>
                </div>
            }
            else
            {
                <div class="kx-panel-body">
                    <label>Prompt</label>
                    <InputTextArea class="form-control" rows="8" @bind-Value="_generatePrompt" disabled="@_busy" />
                </div>
                <div class="kx-panel-foot">
                    <button class="btn btn-primary" type="button" @onclick="SendGenerateAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_generatePrompt))">Generate</button>
                </div>
            }

            @if (_error is not null)
            {
                <div class="kx-panel-foot border-top-0 pt-0"><div class="alert alert-danger mb-0">@_error</div></div>
            }
            @if (_info is not null)
            {
                <div class="kx-panel-foot border-top-0 pt-0"><div class="alert alert-info mb-0">@_info</div></div>
            }
        </div>
    </section>

    @if (HasLabPanels)
    {
        <aside class="kx-chat-side">
            <div class="kx-panel mb-3">
                <div class="kx-panel-head"><h3>Todos</h3></div>
                <div class="kx-panel-body p-2">
                    @if (ConversationTodos.Count == 0)
                    {
                        <p class="small text-muted mb-0">No <code>todo_write</code> payloads yet.</p>
                    }
                    else
                    {
                        <ul class="kx-chat-todo-list mb-0">
                            @foreach (var todo in ConversationTodos)
                            {
                                <li><code>@todo</code></li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="kx-panel mb-3">
                <div class="kx-panel-head"><h3>Artifacts</h3></div>
                <div class="kx-panel-body p-2">
                    @if (ConversationArtifactIds.Count == 0)
                    {
                        <p class="small text-muted mb-0">No artifact ids in this conversation.</p>
                    }
                    else
                    {
                        <ul class="kx-chat-artifact-list mb-0">
                            @foreach (var id in ConversationArtifactIds)
                            {
                                <li><code>@id</code></li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="kx-panel mb-3">
                <div class="kx-panel-head"><h3>Canvas</h3></div>
                <div class="kx-panel-body p-2">
                    @if (string.IsNullOrWhiteSpace(ConversationCanvasJson))
                    {
                        <p class="small text-muted mb-0">No <code>canvas_write</code> yet. Agent can emit structured JSON for this panel.</p>
                    }
                    else
                    {
                        <pre class="small mb-0" style="white-space:pre-wrap;max-height:28rem;overflow:auto">@ConversationCanvasJson</pre>
                    }
                </div>
            </div>

            <div class="kx-panel mb-3">
                <div class="kx-panel-head"><h3>Wiki / discovery</h3></div>
                <div class="kx-panel-body p-2">
                    @if (ConversationWikiRefs.Count == 0)
                    {
                        <p class="small text-muted mb-0">No wiki_search / wiki_grep / compaction events yet.</p>
                    }
                    else
                    {
                        <ul class="kx-chat-artifact-list mb-0">
                            @foreach (var row in ConversationWikiRefs)
                            {
                                <li><span class="badge badge-light">@row.Phase</span> @row.Label</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (_settings.ShowRawJson)
            {
                <div class="kx-panel">
                    <div class="kx-panel-head"><h3>Inspector</h3></div>
                    <div class="kx-panel-body p-2">
                        <label class="small font-weight-bold">Last request</label>
                        <pre class="chat-raw">@FormatRawJson(_lastRequestJson)</pre>
                        <label class="small font-weight-bold">Last response</label>
                        <pre class="chat-raw">@FormatRawJson(_lastResponseJson)</pre>
                        @if (_lastMeta is not null)
                        {
                            <div class="small text-muted mt-2">
                                model: @_lastMeta.Model<br />
                                done: @_lastMeta.DoneReason<br />
                                prompt tokens: @_lastMeta.PromptEvalCount<br />
                                completion tokens: @_lastMeta.EvalCount
                            </div>
                        }
                        @if (_lastWebSearchUsed is not null)
                        {
                            <div class="small text-muted mt-2">
                                <strong>Web search</strong><br />
                                X-Web-Search-Used: @_lastWebSearchUsed<br />
                                @if (_lastWebSearchProvider is not null)
                                {
                                    @:X-Web-Search-Provider: @_lastWebSearchProvider<br />
                                }
                                @if (_lastWebSearchSkipReason is not null)
                                {
                                    @:X-Web-Search-Skip-Reason: @_lastWebSearchSkipReason<br />
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>
    }
</div>

@code {
    private sealed class ChatInputModel { public string Text { get; set; } = string.Empty; }

    [Parameter] public string AppId { get; set; } = string.Empty;

    [Inject] private AdminSession _adminSession { get; set; } = default!;
    [Inject] private AdminApiClient AdminApi { get; set; } = default!;
    [Inject] private ChatClient ChatApi { get; set; } = default!;
    [Inject] private IChatTestSettingsStorage ChatSettingsStorage { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private ElementReference _messagesContainer;
    private ChatTestSettings _settings = new();
    private ChatInputModel _chatInput = new();
    private string _generatePrompt = string.Empty;
    private readonly List<ChatUiMessage> _messages = [];
    private AppDetailDto? _appDetail;
    private string? _lastRequestJson;
    private string? _lastResponseJson;
    private OllamaResponseMeta? _lastMeta;
    private string? _lastWebSearchUsed;
    private string? _lastWebSearchProvider;
    private string? _lastWebSearchSkipReason;
    private CancellationTokenSource? _cts;
    private bool _busy;
    private bool _boundToApp;
    private bool _prefilled;
    private bool _showAdvanced;
    private string? _error;
    private string? _info;

    private bool CanRegenerate =>
        _settings.Mode == ChatEndpointMode.Chat && _messages.Any(m => m.Role == "user");

    private bool HasLabPanels =>
        _settings.Mode == ChatEndpointMode.Chat || _settings.ShowRawJson;

    private IReadOnlyList<string> ConversationArtifactIds =>
        _messages
            .SelectMany(m => m.AgenticSteps)
            .Select(s => s.ArtifactId)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(id => id!)
            .ToList();

    private IReadOnlyList<string> ConversationTodos =>
        _messages
            .SelectMany(m => m.AgenticSteps)
            .Where(s => string.Equals(s.ToolName, "todo_write", StringComparison.OrdinalIgnoreCase))
            .SelectMany(ExtractTodoLines)
            .Distinct(StringComparer.Ordinal)
            .ToList();

    private string? ConversationCanvasJson =>
        _messages
            .SelectMany(m => m.AgenticSteps)
            .Where(s => string.Equals(s.ToolName, "canvas_write", StringComparison.OrdinalIgnoreCase))
            .Select(s => s.Detail ?? s.Label)
            .LastOrDefault(text =>
                !string.IsNullOrWhiteSpace(text)
                && text.TrimStart().StartsWith('{'));

    private IReadOnlyList<(string Phase, string Label)> ConversationWikiRefs =>
        _messages
            .SelectMany(m => m.AgenticSteps)
            .Where(s =>
                string.Equals(s.Phase, "Compacting", StringComparison.OrdinalIgnoreCase)
                || string.Equals(s.ToolName, "wiki_search", StringComparison.OrdinalIgnoreCase)
                || string.Equals(s.ToolName, "wiki_grep", StringComparison.OrdinalIgnoreCase)
                || (s.Label?.Contains("wiki", StringComparison.OrdinalIgnoreCase) ?? false)
                || (s.Detail?.Contains("wiki", StringComparison.OrdinalIgnoreCase) ?? false))
            .Select(s => (
                Phase: string.IsNullOrWhiteSpace(s.Phase) ? (s.ToolName ?? "wiki") : s.Phase,
                Label: s.Label ?? s.Detail ?? s.ToolName ?? s.Phase))
            .Distinct()
            .Take(40)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (path.Equals("chat", StringComparison.OrdinalIgnoreCase)
            || path.Equals("chat-test", StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(AppId))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _boundToApp = true;
        if (!_adminSession.IsConfigured)
            await _adminSession.InitializeAsync();
        _settings = await ChatSettingsStorage.LoadAsync() ?? new ChatTestSettings();
        // Prefer a clean two-column Playground; power users can re-enable Inspector.
        _settings.ShowRawJson = false;
        await PrefillFromAppAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_boundToApp || string.IsNullOrWhiteSpace(AppId))
            return;
        if (_prefilled && string.Equals(_settings.AppId, AppId, StringComparison.OrdinalIgnoreCase))
            return;
        await PrefillFromAppAsync();
    }

    private async Task PrefillFromAppAsync()
    {
        _settings.AppId = AppId.Trim();
        _error = null;
        _info = null;

        if (!_adminSession.IsConfigured)
        {
            _error = "Connect the Admin API before using the Playground.";
            return;
        }

        try
        {
            var credentials = await AdminApi.GetAppCredentialsAsync(AppId);
            if (credentials is not null && !string.IsNullOrWhiteSpace(credentials.ApiKey))
                _settings.ApiKey = credentials.ApiKey;

            if (!string.IsNullOrWhiteSpace(_settings.ApiKey))
            {
                var config = await ChatApi.GetAppConfigAsync(_settings);
                if (config is not null && !string.IsNullOrWhiteSpace(config.LlmModel))
                    _settings.Model = config.LlmModel;
            }

            await ChatSettingsStorage.SaveAsync(_settings);
            _appDetail = await ChatApi.GetAppAsync(_settings);
            if (_appDetail?.LlmModel is { Length: > 0 } m && string.IsNullOrWhiteSpace(_settings.Model))
                _settings.Model = m;

            _prefilled = true;
            _info = "App credentials and model loaded.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string ModeBtnClass(ChatEndpointMode mode) =>
        _settings.Mode == mode ? "active" : "";

    private void SetMode(ChatEndpointMode mode) => _settings.Mode = mode;

    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;

    private static string FormatRawJson(string? json) =>
        string.IsNullOrWhiteSpace(json) ? "—" : json;

    private async Task SaveSettingsAsync()
    {
        try
        {
            await ChatSettingsStorage.SaveAsync(_settings);
            _info = "Settings saved.";
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task LoadAppAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await ChatSettingsStorage.SaveAsync(_settings);
            _appDetail = await ChatApi.GetAppAsync(_settings);
            if (_appDetail?.LlmModel is { Length: > 0 } m && string.IsNullOrWhiteSpace(_settings.Model))
                _settings.Model = m;
            _info = "App metadata loaded.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SendChatAsync()
    {
        if (string.IsNullOrWhiteSpace(_chatInput.Text))
            return;

        BeginRequest();
        var userText = _chatInput.Text.Trim();
        _chatInput.Text = string.Empty;
        _messages.Add(new ChatUiMessage { Role = "user", Content = userText });

        var assistant = new ChatUiMessage { Role = "assistant", Content = string.Empty, IsStreaming = _settings.Stream };
        if (_settings.Stream)
            _messages.Add(assistant);

        try
        {
            await ChatSettingsStorage.SaveAsync(_settings);
            ChatExchangeResult result;

            if (_settings.Stream)
            {
                result = await ChatApi.ChatStreamAsync(
                    _settings,
                    userText,
                    _ => InvokeAsync(StateHasChanged),
                    assistant,
                    _cts!.Token);
            }
            else
            {
                result = await ChatApi.ChatAsync(_settings, userText, _cts!.Token);
                _messages.Add(MapAssistant(result));
            }

            await ApplyResultAsync(result);
            if (_settings.Stream && result.IsError)
                assistant.IsError = true;

            _info = $"Completed in {result.ElapsedMs} ms" +
                    (result.ResponseTimeHeaderMs is not null ? $" (gateway: {result.ResponseTimeHeaderMs} ms)" : "") +
                    (result.MessageId is not null ? $" · msg {result.MessageId}" : "") +
                    (result.SessionId is not null ? $" · session {result.SessionId}" : "");
        }
        catch (OperationCanceledException)
        {
            _info = "Request cancelled.";
            if (_settings.Stream && assistant.IsStreaming)
            {
                assistant.IsStreaming = false;
                assistant.Content += "\n\n[cancelled]";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (_settings.Stream && _messages.Contains(assistant))
            {
                assistant.IsError = true;
                assistant.IsStreaming = false;
            }
        }
        finally
        {
            EndRequest();
            await ScrollToBottomAsync();
        }
    }

    private async Task SendGenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_generatePrompt))
            return;

        BeginRequest();
        var prompt = _generatePrompt.Trim();
        var assistant = new ChatUiMessage { Role = "assistant", Content = string.Empty, IsStreaming = _settings.Stream };
        _messages.Add(new ChatUiMessage { Role = "user", Content = $"[generate]\n{prompt}" });
        if (_settings.Stream)
            _messages.Add(assistant);

        try
        {
            await ChatSettingsStorage.SaveAsync(_settings);
            ChatExchangeResult result;

            if (_settings.Stream)
                result = await ChatApi.GenerateStreamAsync(_settings, prompt, _ => InvokeAsync(StateHasChanged), assistant, _cts!.Token);
            else
                result = await ChatApi.GenerateAsync(_settings, prompt, _cts!.Token);

            if (!_settings.Stream)
                _messages.Add(MapAssistant(result));

            await ApplyResultAsync(result);
            _info = $"Generate done in {result.ElapsedMs} ms.";
        }
        catch (OperationCanceledException) { _info = "Cancelled."; }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            EndRequest();
            await ScrollToBottomAsync();
        }
    }

    private async Task RegenerateAsync()
    {
        var lastUser = _messages.LastOrDefault(m => m.Role == "user");
        if (lastUser is null)
            return;

        while (_messages.Count > 0 && _messages[^1].Role != "user")
            _messages.RemoveAt(_messages.Count - 1);

        BeginRequest();
        var userText = lastUser.Content;
        var assistant = new ChatUiMessage { Role = "assistant", Content = string.Empty, IsStreaming = _settings.Stream };
        if (_settings.Stream)
            _messages.Add(assistant);

        try
        {
            await ChatSettingsStorage.SaveAsync(_settings);
            ChatExchangeResult result;
            if (_settings.Stream)
                result = await ChatApi.ChatStreamAsync(_settings, userText, _ => InvokeAsync(StateHasChanged), assistant, _cts!.Token);
            else
            {
                result = await ChatApi.ChatAsync(_settings, userText, _cts!.Token);
                _messages.Add(MapAssistant(result));
            }
            await ApplyResultAsync(result);
            _info = $"Regenerated in {result.ElapsedMs} ms.";
        }
        catch (OperationCanceledException) { _info = "Cancelled."; }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            EndRequest();
            await ScrollToBottomAsync();
        }
    }

    private async Task NewSessionAsync()
    {
        _settings.SessionId = string.Empty;
        _messages.Clear();
        _lastRequestJson = null;
        _lastResponseJson = null;
        _lastMeta = null;
        _error = null;
        _info = "New session — the next request will make the API generate a new X-Session-Id.";
        await ChatSettingsStorage.SaveAsync(_settings);
    }

    private async Task CopyAsync(string text) =>
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);

    private Task CopyConfirmTokenAsync(string pendingId) =>
        CopyAsync("[CONFIRM:" + pendingId + "]");

    private void CancelRequest()
    {
        _cts?.Cancel();
        _info = "Cancelling…";
    }

    private void ClearUi()
    {
        _messages.Clear();
        _lastRequestJson = null;
        _lastResponseJson = null;
        _lastMeta = null;
        _error = null;
        _info = null;
    }

    private void BeginRequest()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _busy = true;
        _error = null;
        _info = null;
    }

    private void EndRequest()
    {
        _busy = false;
        _cts?.Dispose();
        _cts = null;
    }

    private async Task ApplyResultAsync(ChatExchangeResult result)
    {
        _lastRequestJson = result.RawRequestJson;
        _lastResponseJson = result.RawResponseJson;
        _lastMeta = result.Meta;
        _lastWebSearchUsed = result.WebSearchUsed;
        _lastWebSearchProvider = result.WebSearchProvider;
        _lastWebSearchSkipReason = result.WebSearchSkipReason;

        if (!string.IsNullOrWhiteSpace(result.SessionId))
        {
            _settings.SessionId = result.SessionId;
            await ChatSettingsStorage.SaveAsync(_settings);
        }

        if (!_settings.Stream && result.IsError)
            return;

        var target = _messages.LastOrDefault(m => m.Role == "assistant");
        if (target is not null && _settings.Stream)
        {
            target.MessageId = result.MessageId;
            target.ElapsedMs = result.ElapsedMs;
            target.IsError = result.IsError;
            target.AwaitingConfirmation = result.AwaitingConfirmation;
            target.PendingConfirmationId = result.PendingConfirmationId;
            target.PromptEvalCount = result.Meta?.PromptEvalCount;
            target.EvalCount = result.Meta?.EvalCount;
        }
    }

    private static ChatUiMessage MapAssistant(ChatExchangeResult result) =>
        new()
        {
            Role = "assistant",
            Content = result.Content,
            FinalContent = string.IsNullOrEmpty(result.FinalContent) ? result.Content : result.FinalContent,
            AgenticSteps = result.AgenticSteps,
            AwaitingConfirmation = result.AwaitingConfirmation,
            PendingConfirmationId = result.PendingConfirmationId,
            MessageId = result.MessageId,
            ElapsedMs = result.ElapsedMs,
            IsError = result.IsError,
            PromptEvalCount = result.Meta?.PromptEvalCount,
            EvalCount = result.Meta?.EvalCount
        };

    private static string StepIcon(string status) =>
        status switch
        {
            "done" => "\u2713",
            "error" => "\u2717",
            "warning" => "\u26A0",
            "pending" => "\u23F8",
            _ => "\u2026"
        };

    private static string FormatPhase(string phase) =>
        phase switch
        {
            "Compacting" => "Compacting",
            "SubagentStarted" => "Subagent",
            "SubagentCompleted" => "Subagent done",
            "ToolStarted" => "Tool",
            "ToolCompleted" => "Tool done",
            "LlmRequest" => "LLM",
            "Validating" => "Validating",
            _ => phase
        };

    private static IEnumerable<string> ExtractTodoLines(AgenticUiStep step)
    {
        foreach (var text in new[] { step.Detail, step.Label })
        {
            if (string.IsNullOrWhiteSpace(text))
                continue;

            var trimmed = text.Trim();
            var jsonStart = trimmed.IndexOfAny(['[', '{']);
            if (jsonStart >= 0)
            {
                var json = trimmed[jsonStart..];
                yield return json.Length > 240 ? json[..240] + "…" : json;
                yield break;
            }

            if (!string.Equals(trimmed, step.Phase, StringComparison.OrdinalIgnoreCase)
                && trimmed.Contains("todo", StringComparison.OrdinalIgnoreCase))
            {
                yield return trimmed.Length > 240 ? trimmed[..240] + "…" : trimmed;
                yield break;
            }
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("eval", "document.querySelector('.chat-messages')?.scrollTo(0, 999999)");
        }
        catch
        {
            // ignore
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
