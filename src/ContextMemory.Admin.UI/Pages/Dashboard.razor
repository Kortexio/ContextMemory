@page "/"
@page "/apps"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout
@implements IDisposable

<PageTitle>Dashboard - Kortexio Admin</PageTitle>

@if (!Session.IsConfigured)
{
    <div class="kx-empty kx-empty-lg">
        <h2>Connect your API</h2>
        <p>
            This console talks to ContextMemory over HTTP.
            Paste the Master Key and open your memory layer as a wiki.
        </p>
        <NavLink class="btn btn-primary" href="/settings">Connect</NavLink>
    </div>
}
else
{
    <div class="kx-page-header">
        <div>
            <h1 class="kx-page-title">Dashboard</h1>
            <p class="kx-page-lead">Overview of apps, requests, and wiki memory across your workspace.</p>
        </div>
        <div class="kx-page-actions">
            <NavLink class="btn btn-primary" href="/apps/new">
                <i class="fas fa-plus"></i> New app
            </NavLink>
            <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="kx-loading-banner">
            <i class="fas fa-spinner fa-spin"></i> Loading dashboard…
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">
            @_error
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Retry</button>
                <NavLink class="btn btn-sm btn-outline-secondary ml-1" href="/settings">Check connection</NavLink>
            </div>
        </div>
    }
    else
    {
        <div class="kx-metrics">
            <div class="kx-metric">
                <div class="kx-metric-label">Applications</div>
                <div class="kx-metric-value">@_apps.Count</div>
            </div>
            <div class="kx-metric">
                <div class="kx-metric-label">Total requests</div>
                <div class="kx-metric-value">@_totalRequests</div>
            </div>
            <div class="kx-metric">
                <div class="kx-metric-label">Active users</div>
                <div class="kx-metric-value">@_totalUsers</div>
            </div>
            <div class="kx-metric">
                <div class="kx-metric-label">Wiki pages</div>
                <div class="kx-metric-value">@_totalWiki</div>
            </div>
        </div>

        <div class="kx-activity-grid">
            <section class="kx-panel">
                <div class="kx-panel-head">
                    <div>
                        <h2>Requests</h2>
                        <p>API traffic across registered applications.</p>
                    </div>
                    <div class="kx-panel-stat">@_totalRequests</div>
                </div>
                @if (_apps.Count == 0 || _totalRequests == 0)
                {
                    <div class="kx-panel-empty">
                        <p>No request activity yet.</p>
                        <NavLink class="btn btn-sm btn-outline-secondary" href="/chat">Try Playground</NavLink>
                    </div>
                }
                else
                {
                    <ul class="kx-panel-list">
                        @foreach (var app in _apps.OrderByDescending(a => a.Stats?.RequestsTotal ?? 0).Take(5))
                        {
                            <li>
                                <a href="/apps/@app.AppId">@app.AppId</a>
                                <strong>@(app.Stats?.RequestsTotal ?? 0)</strong>
                            </li>
                        }
                    </ul>
                }
                <div class="kx-panel-foot">
                    <NavLink href="/apps/new">Register app</NavLink>
                </div>
            </section>

            <section class="kx-panel">
                <div class="kx-panel-head">
                    <div>
                        <h2>Wiki memory</h2>
                        <p>Pages indexed into the shared knowledge layer.</p>
                    </div>
                    <div class="kx-panel-stat">@_totalWiki</div>
                </div>
                @if (_apps.Count == 0 || _totalWiki == 0)
                {
                    <div class="kx-panel-empty">
                        <p>No wiki pages indexed for this range.</p>
                        <NavLink class="btn btn-sm btn-outline-secondary" href="/apps/new">Create app</NavLink>
                    </div>
                }
                else
                {
                    <ul class="kx-panel-list">
                        @foreach (var app in _apps.OrderByDescending(a => a.Stats?.WikiPagesTotal ?? 0).Take(5))
                        {
                            <li>
                                <a href="/apps/@app.AppId/config">@app.AppId</a>
                                <strong>@(app.Stats?.WikiPagesIncluded ?? 0)/@(app.Stats?.WikiPagesTotal ?? 0)</strong>
                            </li>
                        }
                    </ul>
                }
                <div class="kx-panel-foot">
                    <NavLink href="/chat">Open Playground</NavLink>
                </div>
            </section>
        </div>

        @if (_apps.Count == 0)
        {
            <div class="kx-empty">
                <h2>No apps yet</h2>
                <p>
                    Create an application to start capturing session memory,
                    or wait for the seeded <code>demo-dev</code> app after the API starts.
                </p>
                <NavLink class="btn btn-primary" href="/apps/new">Create app</NavLink>
                <NavLink class="btn btn-outline-secondary ml-2" href="/chat">Open Playground</NavLink>
            </div>
        }
        else
        {
            <div class="kx-section-head">
                <h2>Applications</h2>
                <p>Jump into config, stats, or Chat Lab for each tenant.</p>
            </div>

            <div class="kx-app-grid">
                @foreach (var app in _apps)
                {
                    <article class="kx-app-card">
                        <div class="kx-app-card-head">
                            <h3>@app.AppId</h3>
                            <span class="kx-badge">@app.Source</span>
                        </div>
                        <div class="kx-app-card-body">
                            <div class="kx-app-stat">
                                <small>Requests</small>
                                <strong>@(app.Stats?.RequestsTotal ?? 0)</strong>
                            </div>
                            <div class="kx-app-stat">
                                <small>Users</small>
                                <strong>@(app.Stats?.ActiveUsers ?? 0)</strong>
                            </div>
                            <div class="kx-app-stat">
                                <small>Wiki</small>
                                <strong>@(app.Stats?.WikiPagesIncluded ?? 0)/@(app.Stats?.WikiPagesTotal ?? 0)</strong>
                            </div>
                        </div>
                        <div class="kx-app-card-foot">
                            <a class="btn btn-sm btn-primary" href="/apps/@app.AppId">Details</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/apps/@app.AppId/config">Config</a>
                            <a class="btn btn-sm btn-outline-info" href="/chat">Playground</a>
                        </div>
                    </article>
                }
            </div>
        }

        <div class="kx-explore">
            <div class="kx-section-head">
                <h2>Explore the platform</h2>
                <p>Shortcuts to configure memory, test retrieval, and wire clients.</p>
            </div>
            <div class="kx-explore-grid">
                <a class="kx-explore-card" href="/apps/new">
                    <span class="kx-explore-tag">Suggested</span>
                    <h3>Register an app</h3>
                    <p>Create a tenant with its own API key and wiki scope.</p>
                </a>
                <a class="kx-explore-card" href="/chat">
                    <h3>Try the Playground</h3>
                    <p>Add and retrieve memory live against your ContextMemory API.</p>
                </a>
                <a class="kx-explore-card" href="/skills">
                    <h3>Skills</h3>
                    <p>Browse agent skills available to your memory-aware agents.</p>
                </a>
                <a class="kx-explore-card" href="/settings">
                    <h3>API connection</h3>
                    <p>Point the console at your ContextMemory base URL and master key.</p>
                </a>
            </div>
        </div>
    }
}

@code {
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private AdminSession Session { get; set; } = default!;

    private IReadOnlyList<AdminAppListItem> _apps = [];
    private bool _loading = true;
    private string? _error;

    private long _totalRequests;
    private long _totalUsers;
    private long _totalWiki;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        await EnsureSessionAsync();
        await LoadAsync();
    }

    private async void HandleSessionChanged() => await InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task EnsureSessionAsync()
    {
        if (!Session.IsConfigured)
            await Session.InitializeAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        if (!Session.IsConfigured)
        {
            _apps = [];
            ResetTotals();
            _loading = false;
            return;
        }

        try
        {
            _apps = await Api.GetAppsAsync();
            _totalRequests = _apps.Sum(a => a.Stats?.RequestsTotal ?? 0);
            _totalUsers = _apps.Sum(a => a.Stats?.ActiveUsers ?? 0);
            _totalWiki = _apps.Sum(a => a.Stats?.WikiPagesTotal ?? 0);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _apps = [];
            ResetTotals();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetTotals()
    {
        _totalRequests = 0;
        _totalUsers = 0;
        _totalWiki = 0;
    }

    public void Dispose() => Session.Changed -= HandleSessionChanged;
}
