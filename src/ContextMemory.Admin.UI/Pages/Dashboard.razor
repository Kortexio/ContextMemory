@page "/"
@page "/apps"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout MainLayout
@implements IDisposable

<PageTitle>Applications - Kortexio Admin</PageTitle>

@if (!Session.IsConfigured)
{
    <div class="kx-empty">
        <h2>Connect your API</h2>
        <p>
            This console talks to ContextMemory over HTTP.
            Paste the Master Key and open your memory layer as a wiki.
        </p>
        <NavLink class="btn btn-primary" href="/settings">Connect</NavLink>
    </div>
}
else
{
    <div class="kx-page-header">
        <div>
            <h1 class="kx-page-title">Applications</h1>
            <p class="kx-page-lead">Memory you can open as a wiki — apps, sessions, and Chat Lab on one URL.</p>
        </div>
        <div class="d-flex flex-wrap" style="gap:0.5rem">
            <NavLink class="btn btn-primary" href="/apps/new">
                <i class="fas fa-plus"></i> New app
            </NavLink>
            <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_loading">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info"><i class="fas fa-spinner fa-spin"></i> Loading applications…</div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">
            @_error
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Retry</button>
                <NavLink class="btn btn-sm btn-outline-secondary ml-1" href="/settings">Check connection</NavLink>
            </div>
        </div>
    }
    else if (_apps.Count == 0)
    {
        <div class="kx-empty">
            <h2>No apps yet</h2>
            <p>
                Create an application to start capturing session memory,
                or wait for the seeded <code>demo-dev</code> app after the API starts.
            </p>
            <NavLink class="btn btn-primary" href="/apps/new">Create app</NavLink>
            <NavLink class="btn btn-outline-secondary ml-2" href="/chat">Open Chat Lab</NavLink>
        </div>
    }
    else
    {
        <div class="kx-metrics">
            <div class="kx-metric">
                <div class="kx-metric-label">Apps</div>
                <div class="kx-metric-value">@_apps.Count</div>
            </div>
            <div class="kx-metric">
                <div class="kx-metric-label">Requests</div>
                <div class="kx-metric-value">@_totalRequests</div>
            </div>
            <div class="kx-metric">
                <div class="kx-metric-label">Active users</div>
                <div class="kx-metric-value">@_totalUsers</div>
            </div>
            <div class="kx-metric">
                <div class="kx-metric-label">Wiki pages</div>
                <div class="kx-metric-value">@_totalWiki</div>
            </div>
        </div>

        <div class="kx-app-grid">
            @foreach (var app in _apps)
            {
                <article class="kx-app-card">
                    <div class="kx-app-card-head">
                        <h3>@app.AppId</h3>
                        <span class="kx-badge">@app.Source</span>
                    </div>
                    <div class="kx-app-card-body">
                        <div class="kx-app-stat">
                            <small>Requests</small>
                            <strong>@(app.Stats?.RequestsTotal ?? 0)</strong>
                        </div>
                        <div class="kx-app-stat">
                            <small>Users</small>
                            <strong>@(app.Stats?.ActiveUsers ?? 0)</strong>
                        </div>
                        <div class="kx-app-stat">
                            <small>Wiki</small>
                            <strong>@(app.Stats?.WikiPagesIncluded ?? 0)/@(app.Stats?.WikiPagesTotal ?? 0)</strong>
                        </div>
                    </div>
                    <div class="kx-app-card-foot">
                        <a class="btn btn-sm btn-primary" href="/apps/@app.AppId">Details</a>
                        <a class="btn btn-sm btn-outline-secondary" href="/apps/@app.AppId/config">Config</a>
                        <a class="btn btn-sm btn-outline-info" href="/chat">Chat Lab</a>
                    </div>
                </article>
            }
        </div>
    }
}

@code {
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private AdminSession Session { get; set; } = default!;

    private IReadOnlyList<AdminAppListItem> _apps = [];
    private bool _loading = true;
    private string? _error;

    private long _totalRequests;
    private long _totalUsers;
    private long _totalWiki;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        await EnsureSessionAsync();
        await LoadAsync();
    }

    private async void HandleSessionChanged() => await InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task EnsureSessionAsync()
    {
        if (!Session.IsConfigured)
            await Session.InitializeAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        if (!Session.IsConfigured)
        {
            _apps = [];
            ResetTotals();
            _loading = false;
            return;
        }

        try
        {
            _apps = await Api.GetAppsAsync();
            _totalRequests = _apps.Sum(a => a.Stats?.RequestsTotal ?? 0);
            _totalUsers = _apps.Sum(a => a.Stats?.ActiveUsers ?? 0);
            _totalWiki = _apps.Sum(a => a.Stats?.WikiPagesTotal ?? 0);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _apps = [];
            ResetTotals();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetTotals()
    {
        _totalRequests = 0;
        _totalUsers = 0;
        _totalWiki = 0;
    }

    public void Dispose() => Session.Changed -= HandleSessionChanged;
}
