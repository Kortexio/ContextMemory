# Copy to .env before `docker compose up` (optional).

API_PORT=5100
ADMIN_PORT=5200
PUBLIC_API_URL=http://localhost:5100
ADMIN_PUBLIC_URL=http://localhost:5200

# Host Ollama — ContextMemory talks to it via OpenAI-compatible /v1
OLLAMA_ENDPOINT=http://host.docker.internal:11434
DEFAULT_LLM_MODEL=qwen3.5:9b

# Optional: OpenAI / vLLM / any OpenAI-compatible host defaults
# OPENAI_ENDPOINT=http://host.docker.internal:8000
# OPENAI_API_KEY=

MASTER_KEY=cm_master_dev_key_change_me
DEMO_APP_API_KEY=cm_live_dev_key_change_me

# File (default) or Postgres — for Postgres set ConnectionStrings__ContextMemory in compose override
PERSISTENCE_PROVIDER=File
